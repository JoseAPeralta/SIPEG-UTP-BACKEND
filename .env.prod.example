# Plantilla de produccion. NO contiene secretos.
# Copiar a .env.prod (ignorado por Git) en el servidor y completar los campos
# vacios con valores reales antes de desplegar:
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
# Los secretos se generan con: openssl rand -hex 32
# Despues de confirmar que el ADMIN existe en la base, retirar la contrasena de
# bootstrap y dejar vacias las tres variables iniciales del ADMIN; el seed
# conservara el ADMIN existente.

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
# NODE_ENV: mantener `production`. Compose tambien lo fija en los servicios.
NODE_ENV=production
# PORT: mantener `3000`: controla el puerto de loopback del host; el puerto
# interno de la API sigue siendo 3000.
PORT=3000
# IMAGE_TAG: identificador unico de la version desplegada. Actualizarlo en cada
# publicacion; no reutilizar una etiqueta para codigo distinto.
IMAGE_TAG=2026-10-05-r1
# APP_VERSION: identificador de la version visible en logs. Puede coincidir con
# IMAGE_TAG.
APP_VERSION=2026-10-05-r1
# DOCS_ENABLED: mantener `false`. Usar `true` solo para publicar OpenAPI/Scalar.
DOCS_ENABLED=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL la construye Compose con el host `db`; no se define aqui.
# POSTGRES_DB y POSTGRES_USER: conservar una instalacion nueva con
# `sipeg_utp`/`sipeg`. Si ya hay volumen, conservar los valores existentes.
POSTGRES_DB=sipeg_utp
POSTGRES_USER=sipeg
# POSTGRES_PASSWORD: generar con `openssl rand -hex 32`. El hexadecimal evita
# problemas de codificacion en la URL de Compose. Si el volumen ya existe,
# conservar la contrasena vigente: cambiarla aqui no la cambia en PostgreSQL.
POSTGRES_PASSWORD=''

# ---------------------------------------------------------------------------
# Conexiones y ejecucion
# ---------------------------------------------------------------------------
# Valores actuales del proyecto (9, 5000, 30000, 4). Ajustar solo con criterio
# de recursos. La suma de pool x instancias no debe superar max_connections.
DATABASE_POOL_MAX=9
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# Numero de hilos de libuv (Argon2, DNS, fs). Default 4 = vCPU del servidor.
UV_THREADPOOL_SIZE=4

# Limites de recursos por contenedor (ajustar a la RAM real del VPS; los
# defaults estan pensados para 4 GB). La suma de mem_limit no debe superar la
# RAM disponible menos 512 MB para el sistema.
API_MEM_LIMIT=768m
API_CPUS=2.0
DB_MEM_LIMIT=1g
DB_CPUS=2.0
MIGRATE_MEM_LIMIT=512m
CLOUDFLARED_MEM_LIMIT=128m

# ---------------------------------------------------------------------------
# Origenes
# ---------------------------------------------------------------------------
# CORS_ORIGIN: `https://sipeg-utp.com`, sin ruta ni barra final.
CORS_ORIGIN=https://sipeg-utp.com
# TRUSTED_ORIGINS: vacio en este despliegue. Si se autoriza otro origen, URL
# completa; varios separados por comas sin espacios.
TRUSTED_ORIGINS=''

# ---------------------------------------------------------------------------
# Autenticacion
# ---------------------------------------------------------------------------
# AUTH_SECRET: secreto independiente con `openssl rand -hex 32`. Estable entre
# despliegues.
AUTH_SECRET=''
# AUTH_URL, AUTH_ISSUER y AUTH_AUDIENCE: `https://api.sipeg-utp.com`, sin
# sufijo `/api`. Los tres con el mismo valor.
AUTH_URL=https://api.sipeg-utp.com
AUTH_ISSUER=https://api.sipeg-utp.com
AUTH_AUDIENCE=https://api.sipeg-utp.com
# Endpoint interno que consumen el verificador JWT y el health. Mantener el
# loopback del contenedor (puerto interno 3000) para evitar Bot Fight Mode y
# otros challenges del edge. No cambia AUTH_URL, issuer ni audience publicos.
# Compose aplica este mismo default si la variable falta o esta vacia.
AUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
# AUTH_TOKEN_TTL y AUTH_REFRESH_TTL: `15m` y `7d`.
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TTL=7d
# AUTH_REFRESH_COOKIE_SAME_SITE: `lax`: frontend y API comparten el sitio
# `sipeg-utp.com` por HTTPS. Un frontend en Cloudflare Workers bajo el mismo
# dominio registrable usa `lax`, no `none`.
AUTH_REFRESH_COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Enlaces enviados por correo
# ---------------------------------------------------------------------------
# Rutas del frontend; su origen debe coincidir con CORS_ORIGIN.
AUTH_EMAIL_VERIFICATION_URL=https://sipeg-utp.com/verify-email
AUTH_PASSWORD_RESET_URL=https://sipeg-utp.com/reset-password
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h

# ---------------------------------------------------------------------------
# Argon2id
# ---------------------------------------------------------------------------
# Parametros actualmente usados por el codigo (12288, 3, 1). Ajustar solo con
# criterio de recursos.
AUTH_ARGON2_MEMORY_COST=12288
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
LOG_SERVICE_NAME=sipeg-utp-backend
# LOG_PSEUDONYMIZATION_KEY: secreto independiente con `openssl rand -hex 32`.
# Estable para conservar la correlacion de pseudonimos.
LOG_PSEUDONYMIZATION_KEY=''

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN: token completo del tunel `sipeg-produccion`. Solo en
# .env.prod, nunca en el repositorio.
CLOUDFLARE_TUNNEL_TOKEN=''

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PORT=3001
# GRAFANA_ADMIN_USER y GRAFANA_ADMIN_PASSWORD: usuario administrativo y
# contrasena independiente. La contrasena solo se aplica al inicializar un
# volumen vacio de Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=''
# GRAFANA_SECRET_KEY: `openssl rand -hex 32`. Estable entre reinicios.
GRAFANA_SECRET_KEY=''

# ---------------------------------------------------------------------------
# Loki
# ---------------------------------------------------------------------------
# `config.yaml` (retencion de produccion).
LOKI_CONFIG=config.yaml

# ---------------------------------------------------------------------------
# Alertas de Grafana
# ---------------------------------------------------------------------------
# Reutiliza las credenciales MAIL_* de abajo; GF_SMTP_HOST debe incluir el
# puerto (587 para STARTTLS). Sin ALERT_EMAIL_TO las alertas no llegan a nadie.
GF_SMTP_ENABLED=true
GF_SMTP_HOST='smtp.proveedor.com:587'
ALERT_EMAIL_TO=''
ALERT_EMAIL_FROM='no-reply@sipeg-utp.com'
ALERT_EMAIL_FROM_NAME='SIPEG UTP Alertas'
# Limites de recursos de observabilidad (defaults para 4 GB de RAM).
LOKI_MEM_LIMIT=512m
LOKI_CPUS=1.0
GRAFANA_MEM_LIMIT=512m
GRAFANA_CPUS=1.0
ALLOY_MEM_LIMIT=256m
ALLOY_CPUS=0.5
SOCKET_PROXY_MEM_LIMIT=64m
PROMETHEUS_MEM_LIMIT=512m
NODE_EXPORTER_MEM_LIMIT=64m

# ---------------------------------------------------------------------------
# SMTP real de produccion
# ---------------------------------------------------------------------------
# Completar con el proveedor elegido (tarea 6 del plan).
# MAIL_HOST: host SMTP del proveedor, sin esquema ni puerto.
# MAIL_PORT y MAIL_SECURE: `587` + `false` para STARTTLS; `465` + `true` para
# TLS implicito. Confirmar con el proveedor.
# MAIL_USER y MAIL_PASSWORD: credenciales SMTP; se configuran juntas.
# MAIL_FROM: remitente autorizado. Usar el propuesto solo tras verificar el
# dominio y autorizar ese remitente.
MAIL_HOST=''
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=''
MAIL_PASSWORD=''
MAIL_FROM='SIPEG UTP <no-reply@sipeg-utp.com>'

# ---------------------------------------------------------------------------
# ADMIN inicial
# ---------------------------------------------------------------------------
# Las tres primeras son obligatorias en una base sin ADMIN.
# SEED_ADMIN_EMAIL: correo real del administrador inicial.
# SEED_ADMIN_PASSWORD: 12-20 caracteres. `openssl rand -hex 10` genera 20.
# SEED_ADMIN_IDENTIFICATION_NUMBER: identificacion real y unica.
# SEED_ADMIN_FIRST_NAME y SEED_ADMIN_LAST_NAME: nombre y apellido, o los
# valores propuestos.
SEED_ADMIN_EMAIL=''
SEED_ADMIN_PASSWORD=''
SEED_ADMIN_IDENTIFICATION_NUMBER=''
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=SIPEG
