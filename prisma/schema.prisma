generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  ADMIN
}

enum UnitType {
  FACULTY
  SUBDIRECTORATE
}

enum CollaborationRole {
  ORGANIZER
  EDITOR
  VIEWER
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ActivityStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ClassroomType {
  LABORATORY
  CLASSROOM
}

enum ActivityType {
  WORKSHOP
  SEMINAR
  TALK
  OTHER
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlertType {
  PROPOSAL_RECEIVED
  PROPOSAL_UPDATED
  PROPOSAL_RESPONDED
  PROGRAM_UPDATED
  PROGRAM_ARCHIVED
  ACTIVITY_UPDATED
  ACTIVITY_CANCELLED
  CERTIFICATE_ISSUED
}

enum PermissionGrantSource {
  ROLE_DEFAULT
  OVERRIDE
}

model User {
  id                   String     @id @default(cuid())
  name                 String     @db.VarChar(200)
  firstName            String     @map("first_name") @db.VarChar(100)
  lastName             String     @map("last_name") @db.VarChar(100)
  identificationNumber String     @unique @map("identification_number") @db.VarChar(30)
  email                String     @unique @db.VarChar(254)
  emailVerified        Boolean    @default(false) @map("email_verified")
  image                String?    @db.VarChar(500)
  globalRole           GlobalRole @default(USER) @map("global_role")
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  unitId String?             @map("unit_id")
  unit   OrganizationalUnit? @relation("OrganizationalUnitMembers", fields: [unitId], references: [id], onDelete: SetNull)

  careerId String? @map("career_id")
  career   Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)

  headedUnits OrganizationalUnit[] @relation("OrganizationalUnitHead")

  sessions           Session[]
  accounts           Account[]
  createdPrograms    EventProgram[]
  collaborations     Collaboration[]
  grantedPermissions CollaborationPermission[] @relation("GrantedCollaborationPermissions")
  attendance         Attendance[]
  speakerProfile     Speaker?
  proposalFeedback   ProposalFeedback[]
  alerts             Alert[]

  @@index([unitId])
  @@index([careerId])
  @@map("users")
}

model OrganizationalUnit {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(20)
  description String?  @db.Text
  type        UnitType
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  headId String? @map("head_id")
  head   User?   @relation("OrganizationalUnitHead", fields: [headId], references: [id], onDelete: SetNull)

  members       User[]         @relation("OrganizationalUnitMembers")
  careers       Career[]
  eventPrograms EventProgram[]

  @@index([type, isActive])
  @@index([headId])
  @@map("organizational_units")
}

model Career {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(20)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unitId String             @map("unit_id")
  unit   OrganizationalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  users User[]

  @@index([unitId])
  @@map("careers")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  collaborationPermissions CollaborationPermission[]

  @@map("permissions")
}

model EventProgram {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(200)
  description String?       @db.Text
  label       String?       @db.VarChar(100)
  bannerUrl   String?       @map("banner_url") @db.VarChar(500)
  isDefault   Boolean       @default(false) @map("is_default")
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  status      ProgramStatus @default(DRAFT)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationalUnitId String             @map("organizational_unit_id")
  organizationalUnit   OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  activities       Activity[]
  collaborations   Collaboration[]
  speakerProposals SpeakerProposal[]
  alerts           Alert[]

  @@unique([organizationalUnitId], map: "event_programs_default_unit_key", where: { isDefault: true })
  @@index([organizationalUnitId, status])
  @@index([createdById])
  @@map("event_programs")
}

model Activity {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(200)
  description String?        @db.Text
  type        ActivityType
  date        DateTime       @db.Date
  startTime   DateTime       @map("start_time") @db.Time(3)
  endTime     DateTime       @map("end_time") @db.Time(3)
  maxCapacity Int?           @map("max_capacity")
  bannerUrl   String?        @map("banner_url") @db.VarChar(500)
  status      ActivityStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  eventProgramId String       @map("event_program_id")
  eventProgram   EventProgram @relation(fields: [eventProgramId], references: [id], onDelete: Restrict)

  classroomId String?    @map("classroom_id")
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  speakers       ActivitySpeaker[]
  equipment      ActivityEquipment[]
  collaborations Collaboration[]
  attendance     Attendance[]
  alerts         Alert[]

  @@index([eventProgramId, date, status])
  @@index([status, date, startTime])
  @@index([classroomId, date, startTime])
  @@map("activities")
}

model ActivityEquipment {
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(255)

  @@id([activityId, name])
  @@map("activity_equipment")
}

model Speaker {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String?  @unique @db.VarChar(254)
  organization String?  @db.VarChar(150)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  activities ActivitySpeaker[]
  proposals  SpeakerProposal[]

  @@index([lastName, firstName])
  @@map("speakers")
}

model ActivitySpeaker {
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  speakerId String  @map("speaker_id")
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([activityId, speakerId])
  @@index([speakerId])
  @@map("activity_speakers")
}

model Collaboration {
  id        String            @id @default(cuid())
  role      CollaborationRole @default(VIEWER)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  eventProgramId String?       @map("event_program_id")
  eventProgram   EventProgram? @relation(fields: [eventProgramId], references: [id], onDelete: Cascade)

  activityId String?   @map("activity_id")
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  permissions CollaborationPermission[]

  @@unique([eventProgramId, userId], map: "collaborations_program_user_key", where: { eventProgramId: { not: null } })
  @@unique([activityId, userId], map: "collaborations_activity_user_key", where: { activityId: { not: null } })
  @@index([userId])
  @@map("collaborations")
}

model CollaborationPermission {
  collaborationId String        @map("collaboration_id")
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  source      PermissionGrantSource @default(OVERRIDE)
  validFrom   DateTime?             @map("valid_from") @db.Timestamptz(3)
  validUntil  DateTime?             @map("valid_until") @db.Timestamptz(3)
  grantedById String?               @map("granted_by_id")
  grantedBy   User?                 @relation("GrantedCollaborationPermissions", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime              @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@id([collaborationId, permissionId])
  @@index([permissionId])
  @@index([validUntil])
  @@index([grantedById])
  @@map("collaboration_permissions")
}

model Attendance {
  id           String            @id @default(cuid())
  code         String            @unique @db.VarChar(64)
  registeredAt DateTime          @default(now()) @map("registered_at") @db.Timestamptz(3)
  method       AttendanceMethod?
  checkedInAt  DateTime?         @map("checked_in_at") @db.Timestamptz(3)

  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  certificate Certificate?

  @@unique([activityId, userId])
  @@index([userId, checkedInAt])
  @@map("attendance")
}

model Certificate {
  id       String   @id @default(cuid())
  code     String   @unique @db.VarChar(50)
  pdfUrl   String?  @map("pdf_url") @db.VarChar(500)
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  attendanceId String     @unique @map("attendance_id")
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)

  alerts Alert[]

  @@map("certificates")
}

model Classroom {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(50)
  type      ClassroomType
  capacity  Int
  building  String?       @db.VarChar(50)
  floor     Int?
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  amenities    ClassroomAmenity[]
  availability ClassroomAvailability[]
  activities   Activity[]

  @@map("classrooms")
}

model ClassroomAmenity {
  classroomId String    @map("classroom_id")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  amenity     String    @db.VarChar(50)

  @@id([classroomId, amenity])
  @@map("classroom_amenities")
}

model ClassroomAvailability {
  id        String   @id @default(cuid())
  dayOfWeek Int      @map("day_of_week")
  startTime DateTime @map("start_time") @db.Time(3)
  endTime   DateTime @map("end_time") @db.Time(3)
  period    String?  @db.VarChar(30)

  classroomId String    @map("classroom_id")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, dayOfWeek, startTime, endTime])
  @@map("classroom_availability")
}

model SpeakerProposal {
  id                String         @id @default(cuid())
  title             String         @db.VarChar(200)
  content           String         @db.Text
  proposalType      ActivityType   @map("proposal_type")
  estimatedDuration Int?           @map("estimated_duration")
  cvUrl             String?        @map("cv_url") @db.VarChar(500)
  status            ProposalStatus @default(PENDING)
  submittedAt       DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  speakerId String  @map("speaker_id")
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Restrict)

  eventProgramId String       @map("event_program_id")
  eventProgram   EventProgram @relation(fields: [eventProgramId], references: [id], onDelete: Restrict)

  versions ProposalVersion[]
  feedback ProposalFeedback[]
  alerts   Alert[]

  @@index([eventProgramId, status, submittedAt])
  @@index([speakerId])
  @@map("speaker_proposals")
}

model ProposalVersion {
  id                String       @id @default(cuid())
  versionNumber     Int          @map("version_number")
  title             String       @db.VarChar(200)
  content           String       @db.Text
  proposalType      ActivityType @map("proposal_type")
  estimatedDuration Int?         @map("estimated_duration")
  cvUrl             String?      @map("cv_url") @db.VarChar(500)
  submittedAt       DateTime     @default(now()) @map("submitted_at") @db.Timestamptz(3)

  proposalId String          @map("proposal_id")
  proposal   SpeakerProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@unique([proposalId, versionNumber])
  @@map("proposal_versions")
}

model ProposalFeedback {
  id        String   @id @default(cuid())
  content   String?  @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  proposalId String          @map("proposal_id")
  proposal   SpeakerProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([authorId])
  @@map("proposal_feedback")
}

model Alert {
  id        String    @id @default(cuid())
  type      AlertType
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipientId String @map("recipient_id")
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  proposalId String?          @map("proposal_id")
  proposal   SpeakerProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  eventProgramId String?       @map("event_program_id")
  eventProgram   EventProgram? @relation(fields: [eventProgramId], references: [id], onDelete: Restrict)

  activityId String?   @map("activity_id")
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict)

  certificateId String?      @map("certificate_id")
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([recipientId, isRead, createdAt])
  @@index([proposalId])
  @@index([eventProgramId])
  @@index([activityId])
  @@index([certificateId])
  @@map("alerts")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(254)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model Jwks {
  id         String   @id
  publicKey  String   @map("public_key") @db.Text
  privateKey String   @map("private_key") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("jwks")
}
