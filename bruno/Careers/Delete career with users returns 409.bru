meta {
  name: Delete career with users returns 409
  type: http
  seq: 9
  tags: [
    Careers
  ]
}

delete {
  url: {{baseUrl}}/api/v1/careers/{{careerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("careers with associated users cannot be deleted", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Career has associated users.");
  });
}
