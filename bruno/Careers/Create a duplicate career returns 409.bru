meta {
  name: Create a duplicate career returns 409
  type: http
  seq: 6
  tags: [
    Careers
  ]
}

post {
  url: {{baseUrl}}/api/v1/careers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Ingenieria Civil Duplicada",
    "code": "fic-civ"
  }
}

tests {
  test("duplicated career codes are case-insensitive and produce 409", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Career code already exists.");
  });
}
