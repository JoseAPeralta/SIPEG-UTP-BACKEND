meta {
  name: Delete the Otros career returns 409
  type: http
  seq: 10
  tags: [
    Careers
  ]
}

delete {
  url: {{baseUrl}}/api/v1/careers/{{otrosCareerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("the global Otros career is protected from deletion", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("The global Otros career cannot be deleted.");
  });
}
