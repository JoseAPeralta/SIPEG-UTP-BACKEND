meta {
  name: Get another users alert returns 404
  type: http
  seq: 13
  tags: [
    Alerts
  ]
}

get {
  url: {{baseUrl}}/api/v1/alerts/{{myAlertId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("a foreign alert is indistinguishable from a missing one", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Alert not found.");
  });
}
