meta {
  name: List my unread alerts after read-all returns none
  type: http
  seq: 11
  tags: [
    Alerts
  ]
}

get {
  url: {{baseUrl}}/api/v1/alerts?isRead=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("read-all leaves no unread alert behind", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.data.total).to.equal(0);
    expect(body.data.items).to.be.an("array");
    expect(body.data.items.length).to.equal(0);
  });
}
