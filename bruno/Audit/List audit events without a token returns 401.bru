}

get {
  url: {{baseUrl}}/api/v1/audit-events
  body: none
  auth: none
}

tests {
  test("anonymous requests cannot read the audit log", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().success).to.equal(false);
  });
}
