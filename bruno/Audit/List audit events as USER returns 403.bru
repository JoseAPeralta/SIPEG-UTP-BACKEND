meta {
  name: List audit events as USER returns 403
  type: http
  seq: 9
  tags: [
    Audit
  ]
}

get {
  url: {{baseUrl}}/api/v1/audit-events
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("regular users cannot read the audit log", function () {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Insufficient privileges for this resource.");
  });
}
