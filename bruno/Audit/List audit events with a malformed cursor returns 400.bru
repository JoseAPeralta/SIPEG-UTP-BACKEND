meta {
  name: List audit events with a malformed cursor returns 400
  type: http
  seq: 6
  tags: [
    Audit
  ]
}

get {
  url: {{baseUrl}}/api/v1/audit-events?cursor=not-a-cursor
  body: none
  auth: bearer
}

params:query {
  cursor: not-a-cursor
}

auth:bearer {
  token: {{token}}
}

tests {
  test("a cursor that was not issued by the API is rejected before querying", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Invalid cursor.");
  });
}

docs {
  El cursor se valida en el servicio, no en el esquema de la peticion: por eso responde Invalid cursor. y no Validation error.
}
