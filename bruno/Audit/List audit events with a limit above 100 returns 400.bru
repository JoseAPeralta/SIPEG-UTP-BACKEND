meta {
  name: List audit events with a limit above 100 returns 400
  type: http
  seq: 4
  tags: [
    Audit
  ]
}

get {
  url: {{baseUrl}}/api/v1/audit-events?limit=101
  body: none
  auth: bearer
}

params:query {
  limit: 101
}

auth:bearer {
  token: {{token}}
}

tests {
  test("a limit above 100 is rejected before querying the log", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
    expect(body.errors[0].field).to.equal("query.limit");
  });
}

docs {
  El limite por defecto es 20 y el maximo es 100. El cursor es opaco: se obtiene de nextCursor y se reenvia como cursor en la peticion siguiente.
}
