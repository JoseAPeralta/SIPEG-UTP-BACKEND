meta {
  name: Revoke a permission
  type: http
  seq: 47
  tags: [
    Collaborators
  ]
}

delete {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/permissions/report:view?userId={{collaboratorUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ADMIN revokes a local ROLE_DEFAULT permission with 204", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody()).to.be.empty;
  });
}
