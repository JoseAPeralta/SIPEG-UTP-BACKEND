meta {
  name: Add the same collaborator returns 409
  type: http
  seq: 9
  tags: [
    Collaborators
  ]
}

post {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/collaborators
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "userId": "{{collaboratorUserId}}",
    "role": "VIEWER"
  }
}

tests {
  test("a duplicated collaborator in the same scope returns 409", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("User already collaborates in this scope.");
  });
}
