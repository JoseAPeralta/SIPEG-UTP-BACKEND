meta {
  name: Delete the last delegator returns 409
  type: http
  seq: 30
  tags: [
    Collaborators
  ]
}

delete {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/collaborators/seed_user_org-fisc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("the scope must keep at least one collaborator able to delegate", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Cannot remove the last collaborator able to delegate in this scope.");
  });
}
