meta {
  name: Delete the same collaborator returns 404
  type: http
  seq: 27
  tags: [
    Collaborators
  ]
}

delete {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/collaborators/{{collaboratorUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("deleting a missing collaborator returns 404", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Collaborator not found.");
  });
}
