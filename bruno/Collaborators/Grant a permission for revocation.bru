meta {
  name: Grant a permission for revocation
  type: http
  seq: 49
  tags: [
    Collaborators
  ]
}

post {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/permissions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "userId": "{{collaboratorUserId}}",
    "permission": "report:export"
  }
}

tests {
  test("ADMIN prepares an OVERRIDE grant for revocation", function () {
    expect(res.getStatus()).to.equal(200);
    const granted = res
      .getBody()
      .data.permissions.find((entry) => entry.name === "report:export");
    expect(granted).to.be.an("object");
    expect(granted.source).to.equal("OVERRIDE");
  });
}
