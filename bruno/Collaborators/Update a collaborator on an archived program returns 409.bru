meta {
  name: Update a collaborator on an archived program returns 409
  type: http
  seq: 21
  tags: [
    Collaborators
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{archivedProgramId}}/collaborators/{{collaboratorUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role": "VIEWER"
  }
}

tests {
  test("archived event programs cannot change collaborator roles", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Archived event programs cannot be modified.");
  });
}
