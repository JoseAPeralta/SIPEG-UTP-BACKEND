delete {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/permissions/report:view?userId={{collaboratorUserId}}
  body: none
  auth: none
}

tests {
  test("Revoking a permission requires authentication", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
