meta {
  name: Update an unknown collaborator returns 404
  type: http
  seq: 18
  tags: [
    Collaborators
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/collaborators/{{unknownUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role": "VIEWER"
  }
}

tests {
  test("an unknown collaborator cannot change role", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Collaborator not found.");
  });
}
