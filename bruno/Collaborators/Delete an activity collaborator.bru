meta {
  name: Delete an activity collaborator
  type: http
  seq: 32
  tags: [
    Collaborators
  ]
}

delete {
  url: {{baseUrl}}/api/v1/activities/{{collaboratorsActivityId}}/collaborators/{{collaboratorUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ADMIN removes the activity-local collaborator with 204", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody()).to.be.empty;
  });
}
