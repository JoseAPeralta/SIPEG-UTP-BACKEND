meta {
  name: Delete a collaborator as an organizer without grant returns 403
  type: http
  seq: 24
  tags: [
    Collaborators
  ]
}

delete {
  url: {{baseUrl}}/api/v1/event-programs/seed_program_fisc_default/collaborators/{{collaboratorUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ORGANIZER without permission:grant cannot delete collaborators", function () {
    expect(res.getStatus()).to.equal(403);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Insufficient privileges for this resource.");
  });
}
