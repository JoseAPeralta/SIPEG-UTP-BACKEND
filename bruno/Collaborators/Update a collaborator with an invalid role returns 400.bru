meta {
  name: Update a collaborator with an invalid role returns 400
  type: http
  seq: 19
  tags: [
    Collaborators
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/collaborators/{{collaboratorUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role": "OWNER"
  }
}

tests {
  test("an invalid role is rejected before the service", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
  });
}
