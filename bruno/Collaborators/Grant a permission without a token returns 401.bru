meta {
  name: Grant a permission without a token returns 401
  type: http
  seq: 39
  tags: [
    Collaborators
  ]
}

post {
  url: {{baseUrl}}/api/v1/event-programs/{{collaboratorsProgramId}}/permissions
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{collaboratorUserId}}",
    "permission": "report:export"
  }
}

tests {
  test("Granting a permission requires authentication", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
