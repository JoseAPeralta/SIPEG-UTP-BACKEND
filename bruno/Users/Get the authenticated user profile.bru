meta {
  name: Get the authenticated user profile
  type: http
  seq: 1
  tags: [
    Users
  ]
}

get {
  url: {{baseUrl}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

example {
  name: 200 Response
  description: Authenticated user profile.

  request: {
    url: {{baseUrl}}/api/v1/users/me
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {
            "id": "",
            "firstName": "",
            "lastName": "",
            "identificationNumber": "",
            "email": "",
            "globalRole": "USER",
            "unit": "",
            "career": ""
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/users/me
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/users/me
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}
