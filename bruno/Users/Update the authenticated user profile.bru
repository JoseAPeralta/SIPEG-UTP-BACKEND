meta {
  name: Update the authenticated user profile
  type: http
  seq: 2
  tags: [
    Users
  ]
}

patch {
  url: {{baseUrl}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "",
    "lastName": "",
    "unitId": "",
    "careerId": ""
  }
}

example {
  name: 200 Response
  description: Updated user profile.

  request: {
    url: {{baseUrl}}/api/v1/users/me
    method: PATCH
    mode: json
    body:json: {
      {
        "firstName": "",
        "lastName": "",
        "unitId": "",
        "careerId": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {
            "id": "",
            "firstName": "",
            "lastName": "",
            "identificationNumber": "",
            "email": "",
            "globalRole": "USER",
            "unit": "",
            "career": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/users/me
    method: PATCH
    mode: json
    body:json: {
      {
        "firstName": "",
        "lastName": "",
        "unitId": "",
        "careerId": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

