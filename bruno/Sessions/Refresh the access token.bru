meta {
  name: Refresh the access token
  type: http
  seq: 2
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none

  auth: inherit
}

headers {
  Cookie: sipeg-refresh={{refreshCookie}}
}


script:pre-request {
  bru.setVar("previousRefreshCookie", bru.getVar("refreshCookie") ?? "");
}

script:post-response {
  // El refresh token viaja en Set-Cookie y no en el body: la API no lo expone.
  const responseHeaders = res.getHeaders();
  const rawCookie = responseHeaders["set-cookie"] ?? responseHeaders["Set-Cookie"];
  const firstCookie = Array.isArray(rawCookie) ? rawCookie[0] : rawCookie;
  const cookieValue = /sipeg-refresh=([^;]+)/.exec(firstCookie ?? "")?.[1];

  if (cookieValue) {
    bru.setVar("refreshCookie", cookieValue);
  }
  const body = res.getBody();

  if (body?.success && body.data?.accessToken) {
    bru.setVar("token", body.data.accessToken);
  }
}

tests {
  test("refresh returns a rotated refresh token and an EdDSA access token", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.tokenType).to.equal("Bearer");
    const [encodedHeader] = body.data.accessToken.split(".");
    const base64Header = encodedHeader.replace(/-/g, "+").replace(/_/g, "/");
    const header = JSON.parse(Buffer.from(base64Header, "base64").toString("utf8"));
    expect(header.alg).to.equal("EdDSA");
  });
}

example {
  name: 200 Response
  description: New access/refresh token pair.

  request: {
    url: {{baseUrl}}/api/v1/auth/refresh
    method: POST
    mode: json
    body:json: {
      {
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {
            "accessToken": "",
            "accessTokenExpiresAt": "",
            "refreshTokenExpiresAt": "",
            "tokenType": ""
          }
        }
      '''
    }
  }
}

