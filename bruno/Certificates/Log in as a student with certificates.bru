meta {
  name: Log in as a student with certificates
  type: http
  seq: 1
  tags: [
    Certificates
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-Forwarded-For: 203.0.113.241
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.success && body.data?.accessToken) {
    bru.setVar("token", body.data.accessToken);
    bru.setVar("refreshToken", body.data.refreshToken);
  }
}

tests {
  test("the student logs in to read its own certificates", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.accessToken).to.be.a("string");
  });
}
