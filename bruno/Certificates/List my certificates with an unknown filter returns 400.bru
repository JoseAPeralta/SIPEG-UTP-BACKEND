meta {
  name: List my certificates with an unknown filter returns 400
  type: http
  seq: 7
  tags: [
    Certificates
  ]
}

get {
  url: {{baseUrl}}/api/v1/users/me/certificates?userId={{adminUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("the listing cannot be redirected to another user", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
  });

  test("the offending key is named so the client can fix the request", function () {
    const issues = res.getBody().errors;
    expect(issues.length).to.be.at.least(1);
    expect(
      issues.some(function (issue) {
        return issue.message.indexOf("userId") !== -1;
      })
    ).to.equal(true);
  });
}
