meta {
  name: Get my scopes without a token returns 401
  type: http
  seq: 6
  tags: [
    My_Scopes
  ]
}

get {
  url: {{baseUrl}}/api/v1/users/me/scopes
  body: none
  auth: none
}

tests {
  test("authentication is required", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().success).to.equal(false);
  });
}
