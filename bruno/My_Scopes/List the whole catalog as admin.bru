meta {
  name: List the whole catalog as admin
  type: http
  seq: 8
  tags: [
    My_Scopes
  ]
}

get {
  url: {{baseUrl}}/api/v1/users/me/scopes?type=activity&page=1&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ADMIN receives every activity with the full permission catalog as LOCAL", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.limit).to.equal(5);
    expect(body.data.total).to.be.at.least(1);
    expect(body.data.items.length).to.equal(5);
    expect(
      body.data.items.every(function (item) {
        return (
          item.type === "activity" &&
          item.eventProgram !== null &&
          item.permissions.length > 0
        );
      })
    ).to.equal(true);
    expect(
      body.data.items.every(function (item) {
        return item.permissions.every(function (entry) {
          return entry.origin === "LOCAL" && entry.validFrom === null && entry.validUntil === null;
        });
      })
    ).to.equal(true);
  });

  test("the whole catalog paginates deterministically", function () {
    const firstPage = res.getBody().data.items.map(function (item) {
      return item.id;
    });
    expect(new Set(firstPage).size).to.equal(firstPage.length);
  });
}
