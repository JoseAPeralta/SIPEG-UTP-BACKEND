meta {
  name: Create an activity
  type: http
  seq: 8
  tags: [
    Activities
  ]
}

post {
  url: {{baseUrl}}/api/v1/activities
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Actividad temporal payload completo",
    "description": "Cubre speaker, equipment and maxCapacity en una sola llamada.",
    "type": "SEMINAR",
    "date": "2026-12-16",
    "startTime": "14:00",
    "endTime": "16:00",
    "maxCapacity": 40,
    "eventProgramId": "seed_program_fic_default",
    "speakers": [
      {
        "firstName": "Ana",
        "lastName": "Prueba",
        "email": "ana.prueba@utp.ac.pa",
        "organization": "Vicerrectoria de Investigacion"
      }
    ],
    "equipment": ["Proyector", "Pizarra inteligente"]
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.success && body.data?.id) {
    bru.setVar("fullPayloadActivityId", body.data.id);
  }
}

docs {
  Creates an activity in DRAFT status inside an ACTIVE event program, exercising the full payload: speaker, equipment and maxCapacity. Requires the activity:create permission on the target program (or the ADMIN role). The activity stays DRAFT with no attendance, so the closing request deletes it through the API.
}

tests {
  test("a DRAFT with the full payload is created", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string");
    expect(bru.getVar("fullPayloadActivityId")).to.equal(body.data.id);
    expect(body.data.name).to.equal("Actividad temporal payload completo");
    expect(body.data.type).to.equal("SEMINAR");
    expect(body.data.status).to.equal("DRAFT");
    expect(body.data.capacity).to.equal(40);
    expect(body.data.enrolledCount).to.equal(0);
    expect(body.data.checkedInCount).to.equal(0);
  })

  test("the speaker is linked through the minimal public summary", function () {
    const body = res.getBody();
    expect(body.data.speakers).to.have.lengthOf(1);
    expect(body.data.speakers[0].firstName).to.equal("Ana");
    expect(body.data.speakers[0].lastName).to.equal("Prueba");
    expect(body.data.speakers[0].id).to.be.a("string");
    expect(body.data.speakers[0]).to.not.have.property("email");
    expect(body.data.speakers[0]).to.not.have.property("organization");
  })

  test("the equipment is normalized", function () {
    const body = res.getBody();
    expect(body.data.equipment).to.have.lengthOf(2);
    expect(body.data.equipment).to.include("Proyector");
  })
}

example {
  name: 201 Response
  description: Activity created successfully.

  request: {
    url: {{baseUrl}}/api/v1/activities
    method: POST
    mode: json
    body:json: {
      {
        "name": "Actividad temporal payload completo",
        "description": "Cubre speaker, equipment and maxCapacity en una sola llamada.",
        "type": "SEMINAR",
        "date": "2026-12-16",
        "startTime": "14:00",
        "endTime": "16:00",
        "maxCapacity": 40,
        "eventProgramId": "seed_program_fic_default",
        "speakers": [
          {
            "firstName": "Ana",
            "lastName": "Prueba",
            "email": "ana.prueba@utp.ac.pa",
            "organization": "Vicerrectoria de Investigacion"
          }
        ],
        "equipment": ["Proyector", "Pizarra inteligente"]
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Operation completed successfully.",
          "data": {
            "id": "clx0000000000aaaaaaaaaaaaaaaa",
            "name": "Actividad temporal payload completo",
            "description": "Cubre speaker, equipment and maxCapacity en una sola llamada.",
            "type": "SEMINAR",
            "date": "2026-12-16",
            "startTime": "14:00",
            "endTime": "16:00",
            "capacity": 40,
            "bannerUrl": null,
            "status": "DRAFT",
            "enrolledCount": 0,
            "checkedInCount": 0,
            "cancelReason": null,
            "equipment": ["Proyector", "Pizarra inteligente"],
            "speakers": [
              {
                "id": "clx0000000000bbbbbbbbbbbbbbbb",
                "firstName": "Ana",
                "lastName": "Prueba"
              }
            ],
            "classroom": null,
            "eventProgram": {
              "id": "seed_program_fic_default",
              "name": "Facultad de Ingenieria en Sistemas",
              "label": null
            }
          }
        }
      '''
    }
  }
}
