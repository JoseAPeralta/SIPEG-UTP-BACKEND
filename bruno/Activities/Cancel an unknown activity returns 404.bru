meta {
  name: Cancel an unknown activity returns 404
  type: http
  seq: 28
  tags: [
    Activities
  ]
}

post {
  url: {{baseUrl}}/api/v1/activities/{{unknownActivityId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "No existe"
  }
}

tests {
  test("an unknown activity returns 404", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Activity not found.");
  });
}
