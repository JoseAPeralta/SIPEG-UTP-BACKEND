meta {
  name: Get a deleted activity returns 404
  type: http
  seq: 30
  tags: [
    Activities
  ]
}

get {
  url: {{baseUrl}}/api/v1/activities/{{deletableActivityId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("a deleted activity is gone", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().message).to.equal("Activity not found.");
  });
}
