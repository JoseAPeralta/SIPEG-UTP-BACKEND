meta {
  name: Update a draft activity with an invalid status returns 400
  type: http
  seq: 11
  tags: [
    Activities
  ]
}

patch {
  url: {{baseUrl}}/api/v1/activities/{{draftActivityId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "ONGOING"
  }
}

tests {
  test("a status outside DRAFT/SCHEDULED is rejected", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
  });
}
