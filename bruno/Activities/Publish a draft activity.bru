meta {
  name: Publish a draft activity
  type: http
  seq: 12
  tags: [
    Activities
  ]
}

patch {
  url: {{baseUrl}}/api/v1/activities/{{draftActivityId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "SCHEDULED"
  }
}

tests {
  test("publishing moves the activity to SCHEDULED", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.equal(bru.getVar("draftActivityId"));
    expect(body.data.status).to.equal("SCHEDULED");
  });
}
