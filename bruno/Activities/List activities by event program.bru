meta {
  name: List activities by event program
  type: http
  seq: 40
  tags: [
    Activities
  ]
}

get {
  url: {{baseUrl}}/api/v1/activities?page=1&limit=50&when=all&eventProgramId={{eventProgramId}}
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 50
  when: all
  eventProgramId: {{eventProgramId}}
}

docs {
  Public. Filters the global list by event program. Only activities of ACTIVE programs are visible.
}

tests {
  test("returns activities of the requested program", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.items).to.be.an("array");
    body.data.items.forEach(function (activity) {
      expect(activity.eventProgram.id).to.be.a("string");
    });
  })
}
