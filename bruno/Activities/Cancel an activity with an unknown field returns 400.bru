meta {
  name: Cancel an activity with an unknown field returns 400
  type: http
  seq: 29
  tags: [
    Activities
  ]
}

post {
  url: {{baseUrl}}/api/v1/activities/{{draftActivityId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "motive": "Campo desconocido"
  }
}

tests {
  test("an unknown body key is rejected before the service", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
  });
}
