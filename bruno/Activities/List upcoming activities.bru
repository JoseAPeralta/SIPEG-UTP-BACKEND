meta {
  name: List upcoming activities
  type: http
  seq: 2
  tags: [
    Activities
  ]
}

get {
  url: {{baseUrl}}/api/v1/activities
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
}

docs {
  Public. Returns SCHEDULED and ONGOING activities of ACTIVE programs with date greater than or equal to today in the institutional time zone America/Panama. DRAFT activities are never exposed, so an unauthenticated caller sees only the public set.
}

tests {
  test("returns a paginated public list", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.items).to.be.an("array");
    expect(body.data.page).to.equal(1);
    expect(body.data.limit).to.equal(20);
    expect(body.data.total).to.be.at.least(0);
    expect(body.data.totalPages).to.be.at.least(0);
  })

  test("never exposes a DRAFT or a check-in code", function () {
    const body = res.getBody();
    body.data.items.forEach(function (activity) {
      expect(activity.status).to.not.equal("DRAFT");
      expect(activity).to.not.have.property("qrCode");
      expect(activity).to.not.have.property("manualCode");
    });
  })
}

example {
  name: 200 Response
  description: Paginated list of upcoming activities.

  request: {
    url: {{baseUrl}}/api/v1/activities
    method: GET
    mode: none
    params:query: {
      page: 1
      limit: 20
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Operation completed successfully.",
          "data": {
            "items": [
              {
                "id": "seed_activity_fic-taller-acuatica",
                "name": "Taller de acuatica",
                "description": "Sesion practica en el laboratorio.",
                "type": "WORKSHOP",
                "date": "2026-10-03",
                "startTime": "09:00",
                "endTime": "11:00",
                "capacity": 24,
                "bannerUrl": null,
                "speakers": [],
                "classroom": null,
                "eventProgram": {
                  "id": "seed_program_fic_default",
                  "name": "Facultad de Ingenieria en Sistemas",
                  "label": null
                },
                "organizationalUnit": {
                  "type": "FACULTY",
                  "id": "seed_ou_fic",
                  "name": "Facultad de Ingenieria en Sistemas"
                }
              }
            ],
            "page": 1,
            "limit": 20,
            "total": 1,
            "totalPages": 1
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/activities
    method: GET
    mode: none
    params:query: {
      page: 0
      limit: 20
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "Validation error.",
          "errors": [
            {
              "field": "page",
              "message": "Page must be at least 1."
            }
          ]
        }
      '''
    }
  }
}
