meta {
  name: Update a completed activity returns 409
  type: http
  seq: 13
  tags: [
    Activities
  ]
}

patch {
  url: {{baseUrl}}/api/v1/activities/{{seedActivityId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Intento de edicion de una actividad completada"
  }
}

tests {
  test("a completed activity cannot be modified", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Completed or cancelled activities cannot be modified.");
  });
}
