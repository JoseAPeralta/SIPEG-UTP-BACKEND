meta {
  name: List activities with an invalid token returns 401
  type: http
  seq: 48
  tags: [
    Activities
  ]
}

get {
  url: {{baseUrl}}/api/v1/activities?page=1&limit=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer not-a-valid-token
}

docs {
  The list is public, but a present and invalid bearer token responds 401 before the service.
}

tests {
  test("rejects an invalid bearer token", function () {
    expect(res.getStatus()).to.equal(401);
  })
}
