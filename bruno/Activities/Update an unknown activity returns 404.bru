meta {
  name: Update an unknown activity returns 404
  type: http
  seq: 15
  tags: [
    Activities
  ]
}

patch {
  url: {{baseUrl}}/api/v1/activities/{{unknownActivityId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Actividad inexistente"
  }
}

tests {
  test("an unknown activity cannot be updated", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Activity not found.");
  });
}
