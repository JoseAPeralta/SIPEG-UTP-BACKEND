meta {
  name: Update an archived event program returns 409
  type: http
  seq: 11
  tags: [
    Event_Programs
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{archivedProgramId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Foro actualizado"
  }
}

tests {
  test("archived event programs are not editable", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Archived event programs cannot be modified.");
  });
}
