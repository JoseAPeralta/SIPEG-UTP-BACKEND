meta {
  name: Activate a non-draft event program returns 409
  type: http
  seq: 12
  tags: [
    Event_Programs
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{activeProgramId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "ACTIVE"
  }
}

tests {
  test("only draft event programs can be activated", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Only draft event programs can be activated.");
  });
}
