meta {
  name: Get a non-active event program returns 404
  type: http
  seq: 8
  tags: [
    Event_Programs
  ]
}

get {
  url: {{baseUrl}}/api/v1/event-programs/{{archivedProgramId}}
  body: none
  auth: none
}

tests {
  test("non-active event programs are not public", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Event program not found.");
  });
}
