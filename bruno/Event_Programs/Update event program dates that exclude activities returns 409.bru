meta {
  name: Update event program dates that exclude activities returns 409
  type: http
  seq: 14
  tags: [
    Event_Programs
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{eventProgramId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "startDate": "{{startDateExcludingFirstActivity}}"
  }
}

script:pre-request {
  const startDate = bru.getVar("programStartDate");
  const [year, month, day] = String(startDate).split("-").map(Number);
  const next = new Date(Date.UTC(year, month - 1, day + 1));
  bru.setVar("startDateExcludingFirstActivity", next.toISOString().slice(0, 10));
}

docs {
  The seed places the first activity of the program exactly on its start date, so moving the start one day later excludes it. The date is computed from the program detail captured by "Get an event program" to stay robust against the demo seed shifting its relative dates.
}

tests {
  test("dates cannot exclude existing activities", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Event program dates cannot exclude existing activities.");
  });
}
