meta {
  name: Update an event program with an invalid status returns 400
  type: http
  seq: 13
  tags: [
    Event_Programs
  ]
}

patch {
  url: {{baseUrl}}/api/v1/event-programs/{{eventProgramId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "ARCHIVED"
  }
}

tests {
  test("only the ACTIVE status can be set through PATCH", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    expect(body.message).to.equal("Validation error.");
  });
}
