meta {
  name: Register rate limit returns 429
  type: http
  seq: 12
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "rate-limit.register@utp.ac.pa",
    "password": "PruebaSipeg2026*",
    "firstName": "Prueba",
    "lastName": "RateLimit",
    "identificationNumber": "rl-register-identification",
    "unitId": "seed_unit_fic",
    "careerId": "seed_career_fic-civ"
  }
}

tests {
  const attempts = Number(bru.getVar("registerAttempts") ?? 0) + 1;
  bru.setVar("registerAttempts", attempts);
  
  test("fourth register attempt within a minute returns 429", function () {
    if (attempts >= 4) {
      expect(res.getStatus()).to.equal(429);
    } else {
      expect([201, 409, 422, 429]).to.include(res.getStatus());
    }
  });
}

docs {
  Send this request four times within one minute from a clean window to observe the 429. The limiter keys by email+IP (3/min), so keep the fixed email; other requests with the same email from the same IP also count toward that bucket. The companion per-IP limit is 30/min.
}
