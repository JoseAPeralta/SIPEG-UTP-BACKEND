meta {
  name: Logout revoked token returns 401
  type: http
  seq: 5
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: inherit
}

body:json {
  {
    "refreshToken": "{{revokedRefreshToken}}"
  }
}

tests {
  test("refresh token revoked by logout returns 401", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().success).to.equal(false);
  });
}

docs {
  Depende de "Log out and revoke the refresh token": reenvia el token revocado y comprueba que la sesion ya no existe.
}
