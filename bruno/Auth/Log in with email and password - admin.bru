meta {
  name: Log in with email and password - admin
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  const body = res.getBody();

  if (body?.success && body.data?.accessToken) {
    bru.setVar("token", body.data.accessToken);
    bru.setVar("refreshToken", body.data.refreshToken);
  }
}

tests {
  test("login returns an EdDSA access token and a refresh token", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.tokenType).to.equal("Bearer");
    expect(body.data.refreshToken).to.be.a("string");
    const [encodedHeader] = body.data.accessToken.split(".");
    const base64Header = encodedHeader.replace(/-/g, "+").replace(/_/g, "/");
    const header = JSON.parse(Buffer.from(base64Header, "base64").toString("utf8"));
    expect(header.alg).to.equal("EdDSA");
  });

  test("login response does not leak password hashes", function () {
    expect(JSON.stringify(res.getBody())).to.not.include("$argon2");
  });
}

example {
  name: 200 Response
  description: Authenticated. Returns an access/refresh token pair.

  request: {
    url: {{baseUrl}}/api/v1/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {
            "accessToken": "",
            "accessTokenExpiresAt": "",
            "refreshToken": "",
            "refreshTokenExpiresAt": "",
            "tokenType": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

