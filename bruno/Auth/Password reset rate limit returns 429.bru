meta {
  name: Password reset rate limit returns 429
  type: http
  seq: 27
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "rate-limit.{{$timestamp}}.{{$randomInt}}@example.invalid"
  }
}

tests {
  const attempts = Number(bru.getVar("passwordResetAttempts") ?? 0) + 1;
  bru.setVar("passwordResetAttempts", attempts);

  test("fourth password reset request within a minute returns 429", function () {
    if (attempts >= 4) {
      expect(res.getStatus()).to.equal(429);
      expect(res.getBody().message).to.equal(
        "Too many password reset attempts. Try again in one minute."
      );
    } else {
      expect([200, 429]).to.include(res.getStatus());
    }
  });
}

docs {
  Ejecutar cuatro veces dentro de un minuto desde una ventana limpia. Las otras requests de forgot-password de la carpeta tambien consumen el limite independiente de 3/min por IP.
}
