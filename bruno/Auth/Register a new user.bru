example {
  name: 429 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": "",
        "firstName": "",
        "lastName": "",
        "identificationNumber": "",
        "unitId": "",
        "careerId": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
