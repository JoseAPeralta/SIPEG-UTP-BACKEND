meta {
  name: Register a new user
  type: http
  seq: 2
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "password": "",
    "firstName": "",
    "lastName": "",
    "identificationNumber": "",
    "unitId": "",
    "careerId": ""
  }
}

example {
  name: 201 Response
  description: Registration successful. An email verification is sent.

  request: {
    url: {{baseUrl}}/api/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": "",
        "firstName": "",
        "lastName": "",
        "identificationNumber": "",
        "unitId": "",
        "careerId": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {
            "userId": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": "",
        "firstName": "",
        "lastName": "",
        "identificationNumber": "",
        "unitId": "",
        "careerId": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

