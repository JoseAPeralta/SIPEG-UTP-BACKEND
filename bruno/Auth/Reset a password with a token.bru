meta {
  name: Reset a password with a token
  type: http
  seq: 7
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "token": "",
    "newPassword": ""
  }
}

example {
  name: 200 Response
  description: Password reset.

  request: {
    url: {{baseUrl}}/api/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "token": "",
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "data": {}
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "token": "",
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 429 Response
  description: Error response.

  request: {
    url: {{baseUrl}}/api/v1/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        "token": "",
        "newPassword": ""
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 429
      text: Too Many Requests
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "",
          "errors": [
            {
              "field": "",
              "message": ""
            }
          ]
        }
      '''
    }
  }
}
