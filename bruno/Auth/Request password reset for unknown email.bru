meta {
  name: Request password reset for unknown email
  type: http
  seq: 26
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "unknown.{{$timestamp}}.{{$randomInt}}@example.invalid"
  }
}

tests {
  test("unknown email returns the same generic 200 response", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.message).to.equal("If the email is registered, a reset link has been sent.");
    expect(body.data).to.deep.equal({});
  });
}

docs {
  No revela si el email existe. Comparar el status y cuerpo con Request a password reset.
}
