{
  "uid": "sipeg-errors",
  "title": "Errors",
  "description": "Errores inesperados, 5xx por ruta, dependencias fallidas, ciclo de vida del proceso y correlacion por `X-Request-ID`. La bitacora durable de cambios sensibles no vive aqui: se consulta en `GET /api/v1/audit-events` (ADR-0008).",
  "tags": ["sipeg", "loki", "errors"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({service=\"sipeg-utp-backend\"}, environment)",
        "query": {
          "query": "label_values({service=\"sipeg-utp-backend\"}, environment)",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "request_id",
        "label": "Request ID o expresion",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "options": [{ "selected": true, "text": ".*", "value": ".*" }],
        "hide": 0,
        "skipUrlSync": false,
        "description": "Pega el `X-Request-ID` de una peticion para ver todas sus lineas. Por defecto `.*` muestra la cola completa de la API. El valor se inserta tal cual en la consulta, asi que no debe llevar comillas."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errores inesperados",
      "description": "Eventos `http.error.unexpected`: el `errorHandler` recibio algo que no es `ApiError` y respondio 500 sin filtrar detalles al cliente. `event` es structured metadata, asi que se filtra despues de la llave del selector, nunca dentro.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"application\"} | event=\"http.error.unexpected\" [$__auto])) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx en el rango",
