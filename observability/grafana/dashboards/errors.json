    {
      "id": 8,
      "type": "timeseries",
      "title": "Ciclo de vida del proceso",
      "description": "Eventos de arranque y apagado: `app.starting`, `app.listening`, `app.jwks.ready`, `app.shutdown.signal`, `app.shutdown.completed`, `app.shutdown.error`, `app.shutdown.forced`, `app.fatal`. Un `shutdown.signal` sin su `completed` seguido indica un cierre que no termino a tiempo y un `process.exit` forzado.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
