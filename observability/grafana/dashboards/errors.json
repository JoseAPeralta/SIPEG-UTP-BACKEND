          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"access\"} | statusCode=~\"5..\" [$__auto])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Inicios del proceso",
      "description": "Cada `app.starting` es un arranque del proceso Node. En produccion equivale a reinicios del contenedor. En desarrollo esta inflado: `tsx watch` reinicia el proceso en cada cambio de archivo, asi que este numero no es comparable entre entornos.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"infrastructure\"} | event=\"app.starting\" [$__auto]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fallos fatales",
      "description": "`app.fatal` (excepcion no capturada o promesa rechazada) y `app.jwks.failed` (la tabla `jwks` no se pudo preparar). Cualquiera de los dos deja la API sin tokens firmables: por eso el umbral es rojo desde el primer caso.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"infrastructure\"} | event=~\"app[.].fatal|app[.].jwks[.].failed\" [$__auto])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores inesperados por evento y tipo",
      "description": "Agrupa por `event` y por `err_type`. `| json` aplana el objeto `err` de pino con `_`, asi que el serializador produce la etiqueta `err_type`; en produccion el serializador deja solo `type` (ADR-0007), asi que es la unica dimension del error que sobrevive sin exponer `message` ni `stack`.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{event}} / {{err_type}}",
          "expr": "sum by (event, err_type) (count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"application\"} | json | __error__=\"\" [$__auto]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "5xx por ruta",
      "description": "Plantilla de ruta que produjo 5xx. A diferencia del panel homonimo de `API Overview`, aqui solo entran las respuestas fallidas, que suelen concentrarse en pocas rutas. `topk` no se puede aplicar sobre `unwrap`, por eso la latencia no se mezcla en este panel.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{route}}",
          "expr": "topk(10, sum by (route) (count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"access\"} | statusCode=~\"5..\" [$__auto])))"
        }
      ]
    },
