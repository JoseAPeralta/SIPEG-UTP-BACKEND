          "editorMode": "code",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{event}}",
          "expr": "sum by (event) (count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"infrastructure\"} | event=~\"app[.].*\" [$__auto]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Dependencias: eventos de la aplicacion",
      "description": "Fallos que la aplicacion reporta de sus dependencias: Prisma (`prisma.error`, `prisma.warn`) y el envio de correo (`mail.delivery.failed`, en `log_type=\"application\"`). No incluyen ni el destinatario ni el enlace, por la politica de no registrar datos personales. `mail.delivery.failed` se consulta con un `log_type` distinto al de Prisma, asi que son tres consultas y no un `by (event)` unico.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "prisma.error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "prisma.warn" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "mail.delivery.failed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
