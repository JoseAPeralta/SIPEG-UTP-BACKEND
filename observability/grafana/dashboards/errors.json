          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "prisma.error",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"infrastructure\"} | event=\"prisma.error\" [$__auto]))"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "prisma.warn",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"infrastructure\"} | event=\"prisma.warn\" [$__auto]))"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "mail.delivery.failed",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"application\"} | event=\"mail.delivery.failed\" [$__auto]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Fallos de PostgreSQL",
      "description": "Lineas `FATAL`, `PANIC` o `ERROR` del contenedor de base de datos. Sus logs no son JSON: solo llevan la etiqueta `container`, y el nivel se filtra con un `|~` sobre el texto. `container` no puede ir en el selector con un valor catch-all: Loki rechaza un matcher vacio, asi que el nombre del servicio se escribe explicitamente.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({container=\"db\"} |~ \"FATAL|PANIC|ERROR\" [$__auto])) or vector(0)"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Lineas de error de PostgreSQL",
      "description": "Las mismas lineas del contador, en texto. `POSTGRES` escribe `LOG:`, `WARNING:`, `ERROR:`, `FATAL:` y `PANIC:`; los checkpoints y la salida del servidor salen como `LOG:` y no se cuentan como fallo.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 30 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "instant": false,
          "range": true,
          "direction": "backward",
          "expr": "{container=\"db\"} |~ \"FATAL|PANIC|ERROR\""
        }
      ]
    },
    {
      "id": 12,
