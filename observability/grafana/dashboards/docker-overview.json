  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estado por servicio",
      "description": "Código de estado del contenedor actual por proyecto y servicio. 0 Creado, 1 En ejecución, 2 Pausado, 3 Reiniciando, 4 Eliminando, 5 Detenido, 6 Muerto, 7 Desconocido. Un servicio puede desaparecer si Telegraf deja de observar el contenedor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Creado",
                  "color": "yellow",
                  "index": 0
                },
                "1": {
                  "text": "En ejecución",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Pausado",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "Reiniciando",
                  "color": "yellow",
                  "index": 3
                },
                "4": {
                  "text": "Eliminando",
                  "color": "yellow",
                  "index": 4
                },
                "5": {
                  "text": "Detenido",
                  "color": "red",
                  "index": 5
                },
                "6": {
                  "text": "Muerto",
                  "color": "dark-red",
                  "index": 6
                },
                "7": {
                  "text": "Desconocido",
                  "color": "yellow",
                  "index": 7
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (project, service) (docker_container_status_state_code{job=\"docker\",project=~\"$project\",service=~\"$service\"})",
          "legendFormat": "{{project}} / {{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Contenedores en ejecución",
      "description": "Total de contenedores en ejecución reportado por el motor de Docker. Es un valor global del engine y no depende de los filtros de proyecto o servicio. 0 es un valor real; sin datos, Telegraf no está publicando la serie.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 10,
        "y": 0
