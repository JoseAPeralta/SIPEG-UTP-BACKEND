{
  "uid": "sipeg-api-http",
  "title": "SIPEG · API HTTP",
  "description": "Tráfico, errores y latencia de las operaciones de negocio de la API medidas con las métricas Prometheus de la aplicación. Excluye health, JWKS, OpenAPI, docs, unmatched y preflight, que se muestran en un panel técnico separado.",
  "tags": ["sipeg", "prometheus", "api", "http"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "America/Panama",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "API Overview (Loki)",
      "tooltip": "Volumen, latencia y errores desde los logs de la API",
      "type": "link",
      "url": "/d/sipeg-api-overview/api-overview"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Errors (Loki)",
      "tooltip": "Errores agrupados de la API",
      "type": "link",
      "url": "/d/sipeg-errors/errors"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Security (Loki)",
      "tooltip": "Eventos de autenticación y seguridad",
      "type": "link",
      "url": "/d/sipeg-security/security"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(sipeg_http_requests_total{job=\"sipeg-api\"}, environment)",
        "query": {
          "query": "label_values(sipeg_http_requests_total{job=\"sipeg-api\"}, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "method",
        "label": "Método",
        "type": "custom",
        "query": "GET,POST,PATCH,PUT,DELETE,OPTIONS,HEAD",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "route",
        "label": "Ruta (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "options": [{ "selected": true, "text": ".*", "value": ".*" }],
        "hide": 0,
        "skipUrlSync": false,
        "description": "Plantilla de ruta, por ejemplo /api/v1/activities/:id. Se interpreta como expresión regular."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Solicitudes en el rango",
      "description": "Solicitudes de negocio completadas en el rango seleccionado: matched, ruta /api/v1/ excepto health, outcome completed. Sin datos significa que no hay series para los filtros aplicados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "solicitudes"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ratio 5xx",
      "description": "Porcentaje de respuestas 5xx sobre las respuestas de negocio. Si hay tráfico y ningún 5xx el valor es 0; si no hay tráfico, no hay datos. El denominador se limita a un mínimo de una solicitud por segundo para evitar picos por muestras escasas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "noValue": "Sin datos",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * ((sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\", status_code=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval])))) / clamp_min(sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval])), 0.000000001))",
          "instant": true,
          "range": false,
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 en el rango",
      "description": "Percentil 95 de duración de las respuestas completadas en el rango. Se calcula con histogram_quantile sobre los buckets agregados, por lo que es una aproximación.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "noValue": "Sin datos",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(sipeg_http_request_duration_seconds_bucket{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Solicitudes en vuelo",
      "description": "Gauge sin etiquetas del número de solicitudes atendidas en este instante. Sin datos significa que el proceso no expone la métrica o el target está caído.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Sin datos",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sipeg_http_requests_in_flight{job=\"sipeg-api\", environment=~\"$environment\"}",
          "instant": true,
          "range": false,
          "legendFormat": "en vuelo"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "description": "Tasa total y por método de las solicitudes de negocio completadas. Usa $__rate_interval para adaptar la ventana al paso de la consulta.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": []
        },
        "overrides": []
