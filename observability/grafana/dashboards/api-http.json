          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (status_code) (rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", method=~\"$method\", request_kind=\"matched\", route=~\"/api/v1/.*\", route=~\"$route\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{status_code}}"
        }
      ]
