    {
      "id": 10,
      "type": "timeseries",
      "title": "Solicitudes abortadas",
      "description": "Tasa de solicitudes abortadas por ruta: el cliente cerró la conexión antes de completar la respuesta. Si hay tráfico completado y ningún aborto el valor es 0; sin tráfico no hay datos. No se mezclan con la latencia de respuestas completadas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
