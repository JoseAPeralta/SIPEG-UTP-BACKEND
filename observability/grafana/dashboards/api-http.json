    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia p50, p95 y p99",
      "description": "Percentiles de duración de respuestas completadas calculados con histogram_quantile sobre los buckets agregados. Excluye abortos, que no tienen respuesta completa.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
