          "legendFormat": "Duración del scrape",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Colectores con error",
      "description": "Colectores cuya última recolección devolvió `pg_scrape_collector_success=0`. Una tabla vacía significa que ningún collector reportó error; si además Disponibilidad no tiene datos, el job `postgres` no está siendo recolectado.",
