        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "pg_database_connection_limit{job=\"postgres\",datname=~\"$database\"} > 0",
          "legendFormat": "Límite propio · {{datname}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Uso de conexiones",
      "description": "Porcentaje de conexiones usadas sobre el límite global. `clamp_min(...,1)` evita una división por cero si el exporter no publica el límite; 0 % es un valor real, la ausencia de serie significa que no hay datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(pg_stat_database_numbackends{job=\"postgres\",datname=~\"$database\"}) / clamp_min(max(pg_settings_max_connections{job=\"postgres\"}), 1)",
          "legendFormat": "Uso",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
