        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Contrasenas y revocacion de sesiones",
      "description": "`auth.password.changed` y `auth.session.revoked`, los dos en `info` porque son acciones legitimas. El cambio de contrasena revoca ademas las otras sesiones del usuario, pero **cuantas** se revocaron no viaja a los logs: eso si queda en la bitacora durable, en el evento `auth.other_sessions_revoked` de `GET /api/v1/audit-events` (ADR-0008). Un pico de cambios de contrasena sin cambios de perfil alrededor es una senal de compromiso.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
