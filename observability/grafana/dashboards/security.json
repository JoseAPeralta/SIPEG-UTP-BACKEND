          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"access\"} | statusCode=~\"403\" [$__auto])) or vector(0)"
        }
      ]
