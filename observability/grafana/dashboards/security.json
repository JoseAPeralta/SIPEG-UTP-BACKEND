{
  "uid": "sipeg-security",
  "title": "Security",
  "description": "Fallos de login, tokens invalidos, denegaciones de autorizacion, rate limits, cuentas desactivadas, cambios de contrasena y revocacion de sesiones. Estos eventos se retienen 90 dias en produccion (`retention_stream` con `log_type=\"security\"`; ver el limite de longitud de consulta mas abajo). Los actores aparecen como pseudonimo HMAC, nunca como correo ni IP en claro.",
  "tags": ["sipeg", "loki", "security"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({service=\"sipeg-utp-backend\"}, environment)",
        "query": {
          "query": "label_values({service=\"sipeg-utp-backend\"}, environment)",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "request_id",
        "label": "Request ID o expresion",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "options": [{ "selected": true, "text": ".*", "value": ".*" }],
        "hide": 0,
        "skipUrlSync": false,
        "description": "Pega el `X-Request-ID` de una peticion para ver todas sus lineas, incluida la de seguridad. Por defecto `.*` muestra la cola de la API. El valor se inserta tal cual en la consulta, asi que no debe llevar comillas."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fallos de login",
      "description": "`auth.login.failed`. El actor es el HMAC del correo normalizado que se intento usar, asi que el evento no revela si esa cuenta existe: es el mismo evento para correo inexistente y para contrasena incorrecta.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "sum(count_over_time({service=\"sipeg-utp-backend\", environment=~\"$environment\", log_type=\"security\"} | event=\"auth.login.failed\" [$__auto])) or vector(0)"
        }
      ]
    },
    {
