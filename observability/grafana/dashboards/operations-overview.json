        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Estado de jobs esperados",
      "description": "`up` mínimo por job esperado. Un 0 indica que Prometheus no pudo recolectar el target; una fila ausente significa que el job no está configurado o fue eliminado, no que esté saludable. Los jobs de probes se detallan en Availability.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "number" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Caído", "color": "red", "index": 0 },
                      "1": { "text": "Activo", "color": "green", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.align", "value": "center" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "min by (job) (up{job=~\"node|sipeg-api|postgres|docker|blackbox|prometheus\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{job}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true
            },
            "renameByName": {
              "job": "Job",
              "Value": "Estado"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidad de probes",
      "description": "Mínimo de `probe_success` entre todos los probes internos y públicos en la última muestra. 0 significa al menos un probe fallando; sin datos significa que no hay probes o que Blackbox no está siendo recolectado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Fallo", "color": "red", "index": 0 },
                "1": { "text": "Correcto", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "min(probe_success{job=~\"blackbox-internal|blackbox-public\"})",
          "instant": true,
          "range": false,
          "legendFormat": "probes"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Probes fallidos",
      "description": "Probes con `probe_success=0` en la última muestra. Si no hay filas puede significar que ninguno falló o que no hay muestras; contrastar con Disponibilidad de probes y Estado de jobs esperados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "number" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Fallo", "color": "red", "index": 0 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.align", "value": "center" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "probe_success{job=~\"blackbox-internal|blackbox-public\"} == 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{route}} · {{check}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "module": true
            },
            "renameByName": {
              "route": "Ruta",
              "check": "Comprobación",
              "Value": "Estado"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU del VPS",
      "description": "Porcentaje de CPU del host calculado como 1 menos el tiempo idle. Un 0 es un valor real; sin datos indica que el target `node` está caído o no se está recolectando.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memoria disponible",
      "description": "Porcentaje de memoria disponible del host según MemAvailable. Menos de 10 % es crítico y menos de 20 % requiere atención. Un 0 real no es lo mismo que la ausencia de datos del target.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 20 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "instant": true,
          "range": false,
          "legendFormat": "disponible"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Disco raíz usado",
      "description": "Porcentaje usado del filesystem montado en /, con la misma fórmula del dashboard VPS. Sin datos significa que el mountpoint no está presente o que el target `node` no responde.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\", mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{job=\"node\", mountpoint=\"/\", fstype!=\"tmpfs\"})",
          "instant": true,
          "range": false,
          "legendFormat": "raíz"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Swap usado",
      "description": "Bytes de swap en uso. Un 0 es real cuando el host no tiene swap o no lo está usando; sin datos indica que el target `node` no responde. La swap no sustituye la memoria disponible como señal principal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 268435456 },
              { "color": "red", "value": 1073741824 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "node_memory_SwapTotal_bytes{job=\"node\"} - node_memory_SwapFree_bytes{job=\"node\"}",
          "instant": true,
          "range": false,
          "legendFormat": "swap"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "RPS de negocio",
      "description": "Solicitudes por segundo completadas y enrutadas, excluyendo health. Usa solo `request_kind=\"matched\"`, rutas `/api/v1/*` y `outcome=\"completed\"`. Sin datos no es cero: revisar Estado de jobs esperados.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", request_kind=\"matched\", route=~\"/api/v1/.*\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Ratio 5xx",
      "description": "Porcentaje de respuestas 5xx sobre el total de negocio en la ventana de rate. Si no hay tráfico no se muestra 0 %: el panel queda sin datos. El 0 real se muestra cuando hay tráfico y ningún 5xx.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "100 * ((sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", request_kind=\"matched\", route=~\"/api/v1/.*\", route!=\"/api/v1/health\", outcome=\"completed\", status_code=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", request_kind=\"matched\", route=~\"/api/v1/.*\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval]))) / (sum(rate(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\", request_kind=\"matched\", route=~\"/api/v1/.*\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval])) > 0))",
          "instant": true,
          "range": false,
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "p95 de latencia",
      "description": "Percentil 95 agregado de las operaciones de negocio, calculado sobre los buckets del histograma. Es una aproximación: los valores por encima del último bucket quedan acotados. Sin tráfico puede no haber datos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sipeg_http_request_duration_seconds_bucket{job=\"sipeg-api\", environment=~\"$environment\", request_kind=\"matched\", route=~\"/api/v1/.*\", route!=\"/api/v1/health\", outcome=\"completed\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Solicitudes de negocio en 5 min",
      "description": "Conteo de solicitudes completadas en los últimos 5 minutos. Un 0 con series presentes indica ausencia de tráfico; sin datos indica que el target o la métrica no están disponibles. Sirve para interpretar el ratio 5xx y el p95.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
