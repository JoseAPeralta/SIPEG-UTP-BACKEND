{
  "uid": "sipeg-nodejs-runtime",
  "title": "SIPEG · Node.js Runtime",
  "description": "Recursos del proceso Node.js de la API medidos con los colectores oficiales de Prometheus. La CPU se expresa en núcleos de proceso y la memoria en bytes del proceso; ninguna de las dos equivale al consumo del contenedor.",
  "tags": ["sipeg", "prometheus", "nodejs", "runtime"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "America/Panama",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "API Overview (Loki)",
      "tooltip": "Volumen, latencia y errores desde los logs de la API",
      "type": "link",
      "url": "/d/sipeg-api-overview/api-overview"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Errors (Loki)",
      "tooltip": "Errores agrupados de la API",
      "type": "link",
      "url": "/d/sipeg-errors/errors"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Security (Loki)",
      "tooltip": "Eventos de autenticación y seguridad",
      "type": "link",
      "url": "/d/sipeg-security/security"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Entorno",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\"}, environment)",
        "query": {
          "query": "label_values(sipeg_http_requests_total{job=\"sipeg-api\", environment=~\"$environment\"}, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "description": "Entorno de la API. Filtra las métricas del proceso y del runtime, que heredan la etiqueta environment del registry."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Target de la API",
      "description": "1 indica que Prometheus puede scrapear el listener privado de métricas. 0 indica target caído. Sin datos indica que el target no está presente.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Caído", "color": "red", "index": 0 },
                "1": { "text": "Activo", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "up{job=\"sipeg-api\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime del proceso",
      "description": "Segundos desde process_start_time_seconds. Un reinicio del proceso se refleja como un descenso del valor.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "time() - process_start_time_seconds{job=\"sipeg-api\", environment=~\"$environment\"}",
          "instant": true,
          "range": false,
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Versión de Node.js",
      "description": "Versión reportada por nodejs_version_info. Permite confirmar que la imagen desplegada ejecuta la versión esperada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "Value #A": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "version": "Versión",
              "major": "Mayor",
              "minor": "Menor",
              "patch": "Parche"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "nodejs_version_info{job=\"sipeg-api\", environment=~\"$environment\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU del proceso",
      "description": "Núcleos equivalentes consumidos por el proceso: rate(process_cpu_seconds_total). No es un porcentaje del límite de CPU del contenedor; para eso hace falta la métrica de Docker. Se muestran el total, el tiempo de usuario y el de sistema.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "núcleos",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "rate(process_cpu_seconds_total{job=\"sipeg-api\", environment=~\"$environment\"}[$__rate_interval])",
          "instant": false,
          "range": true,
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "rate(process_cpu_user_seconds_total{job=\"sipeg-api\", environment=~\"$environment\"}[$__rate_interval])",
          "instant": false,
          "range": true,
          "legendFormat": "usuario"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "rate(process_cpu_system_seconds_total{job=\"sipeg-api\", environment=~\"$environment\"}[$__rate_interval])",
          "instant": false,
          "range": true,
          "legendFormat": "sistema"
        }
      ]
    },
