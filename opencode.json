{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    },
    "bruno": {
      "type": "local",
      "command": ["pnpm", "exec", "bruno-mcp", "--collection", "bruno", "--no-auto-discovery"],
      "enabled": true
    }
  }
}
