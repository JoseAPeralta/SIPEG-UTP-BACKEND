# Aplicacion (host y contenedores)
NODE_ENV=development
PORT=3000
DATABASE_URL=""
CORS_ORIGIN="http://localhost:5173"

# Pool de conexiones PostgreSQL (por instancia de la API).
# Default 9 = 2 x vCPU + 1 para un servidor de 4 vCPU.
# La suma de pool x instancias no debe superar max_connections de Postgres (100 por defecto).
# DATABASE_POOL_MAX=9
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Numero de hilos de libuv (Argon2, DNS, fs). Default 4 = vCPU del servidor.
# UV_THREADPOOL_SIZE=4

# Auth (REQUERIDO; generar con: openssl rand -base64 32)
# Nombres library-agnostic: la app no expone el proveedor de auth en env vars.
#
# NOTA sobre Docker Compose: docker compose lee este archivo .env automaticamente,
# pero las variables solo se inyectan al contenedor si estan referenciadas en el
# bloque `environment:` del compose file. Los compose files declaran AUTH_SECRET,
# URLs/TTL de auth y el transporte SMTP; produccion exige MAIL_HOST y MAIL_FROM.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_ISSUER=""
AUTH_AUDIENCE=""
AUTH_TOKEN_TTL="15m"
AUTH_REFRESH_TTL="7d"
AUTH_EMAIL_VERIFICATION_URL="http://localhost:5173/verify-email"
AUTH_PASSWORD_RESET_URL="http://localhost:5173/reset-password"
AUTH_EMAIL_VERIFICATION_TTL="24h"
AUTH_PASSWORD_RESET_TTL="1h"
LOG_LEVEL="info"

# Logging estructurada (pino): JSON de una linea a stdout/stderr, recogido por Grafana Alloy.
# LOG_PRETTY=true                  # salida legible (pino-pretty) para desarrollo local; nunca en produccion
# LOG_SERVICE_NAME="sipeg-utp-backend"
# APP_VERSION="1.0.0"
# Clave HMAC (>=32 chars; generar con: openssl rand -base64 32) para pseudonimizar emails/IPs
# en eventos de seguridad. REQUERIDA en produccion.
# LOG_PSEUDONYMIZATION_KEY=""

# Correo transaccional. En desarrollo Docker, Mailpit usa host `mailpit` y puerto 1025.
# En produccion MAIL_HOST es obligatorio. MAIL_USER y MAIL_PASSWORD van juntos.
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="SIPEG UTP <no-reply@sipeg.local>"

# Documentacion OpenAPI/Scalar. Default: habilitada salvo NODE_ENV=production.
# DOCS_ENABLED=true

# Origins adicionales separados por coma (sin espacios). Se unen a CORS_ORIGIN.
# Dejar SIN definir para no agregar ninguno (un valor vacio es invalido).
# TRUSTED_ORIGINS=""

# Password hashing (opcional; defaults OWASP para 4 vCPU con RAM limitada).
# Cualquier configuracion de la lista OWASP es valida; bajar memoria exige subir
# iteraciones (m 12288 -> t 3, o m 9216 -> t 4). El pico con 4 hilos es m x 4 bytes.
# AUTH_ARGON2_MEMORY_COST=12288
# AUTH_ARGON2_TIME_COST=3
# AUTH_ARGON2_PARALLELISM=1

# Seed demo de datos de prueba (solo desarrollo; `pnpm prisma:seed`).
# Password unica para los usuarios demo; default: Sipeg2026*UTP.
# SEED_DEMO_PASSWORD="Sipeg2026*UTP"
# El seed demo aborta con NODE_ENV=production salvo que definas SEED_ALLOW_PRODUCTION=true.
# SEED_ALLOW_PRODUCTION=false

# Seed base de produccion (`pnpm prisma:seed:base`): catalogos institucionales
# (unidades, programas predeterminados, carreras, aulas y permisos) mas el ADMIN
# inicial. Crea solo lo que falta: no sobrescribe filas existentes.
# El bootstrap del ADMIN es opcional si ya existe un ADMIN en la base; en una
# base vacia es obligatorio y las tres primeras variables van juntas.
# No se versionan valores reales; define estas variables en .env.prod o en el CI.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_IDENTIFICATION_NUMBER=""
# SEED_ADMIN_FIRST_NAME="Administrador"
# SEED_ADMIN_LAST_NAME="SIPEG"

# Desarrollo local: docker compose -f compose.dev.yaml up --build
# Estos valores tienen defaults solo para desarrollo; no los uses en produccion.
POSTGRES_DB=sipeg_utp
POSTGRES_USER=sipeg
POSTGRES_PASSWORD=sipeg_password
POSTGRES_PORT=5432
