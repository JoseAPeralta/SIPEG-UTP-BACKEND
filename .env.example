# Aplicacion (host y contenedores)
NODE_ENV=development
PORT=3000
DATABASE_URL=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Desarrollo local: docker compose -f compose.dev.yaml up --build
# Estos valores tienen defaults solo para desarrollo; no los uses en produccion.
POSTGRES_DB=sipeg_utp
POSTGRES_USER=sipeg
POSTGRES_PASSWORD=sipeg_password
POSTGRES_PORT=5432

# Produccion: docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
# Usa secretos reales. No uses los valores de desarrollo anteriores.
# DATABASE_URL se construye automaticamente en compose.prod.yaml con host "db";
# no la definas aqui. Si POSTGRES_PASSWORD usa caracteres especiales (@ : / ? # %),
# debes codificarlos en porcentaje o mantenerla con caracteres alfanumericos.
# IMAGE_TAG=1.0.0
# POSTGRES_DB=sipeg_utp
# POSTGRES_USER=sipeg
# POSTGRES_PASSWORD=secreto-fuerte
# JWT_ACCESS_SECRET=secreto-aleatorio-de-32-o-mas-caracteres
# JWT_REFRESH_SECRET=secreto-aleatorio-de-32-o-mas-caracteres
# CORS_ORIGIN=https://tu-frontend.example.com
