exports[`contact-points.yaml: notificaciones > conserva contacto, recuperación, agrupación y frecuencias 1`] = `
{
  "apiVersion": 1,
  "contactPoints": [
    {
      "name": "sipeg-email",
      "orgId": 1,
      "receivers": [
        {
          "disableResolveMessage": false,
          "settings": {
            "addresses": "$ALERT_EMAIL_TO",
            "singleEmail": true,
          },
          "type": "email",
          "uid": "sipeg-email",
        },
      ],
    },
  ],
}
`;

exports[`metrics.yaml: contrato previo > conserva toda la configuración excepto anotaciones 1`] = `
{
  "apiVersion": 1,
  "groups": [
    {
      "folder": "SIPEG UTP",
