exports[`notification-policies.yaml: notificaciones > conserva contacto, recuperación, agrupación y frecuencias 1`] = `
{
  "apiVersion": 1,
  "policies": [
    {
      "group_by": [
        "grafana_folder",
        "alertname",
      ],
      "group_interval": "5m",
      "group_wait": "30s",
      "orgId": 1,
      "receiver": "sipeg-email",
      "repeat_interval": "4h",
    },
  ],
}
`;

