        <mxCell id="alerts" value="&lt;b&gt;alerts&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;type (AlertType)&lt;br&gt;is_read&lt;br&gt;created_at&lt;br&gt;recipient_id (FK)&lt;br&gt;proposal_id (FK?)&lt;br&gt;event_program_id (FK?)&lt;br&gt;activity_id (FK?)&lt;br&gt;certificate_id (FK?)&lt;hr&gt;CHECK: exactamente una referencia" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2760" y="120" width="320" height="310" as="geometry" />
