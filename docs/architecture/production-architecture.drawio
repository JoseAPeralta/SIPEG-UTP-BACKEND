        <mxCell id="e-telegraf-proxy" value="GET stats · 2375" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;strokeColor=#0d9488;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;jumpStyle=arc;" edge="1" parent="vps" source="telegraf" target="socket-proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-blackbox-internal" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#0d9488;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="monitoring" source="blackbox" target="internal-probes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-blackbox-public" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;strokeColor=#0d9488;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="monitoring" source="blackbox" target="public-probes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-vps-smtp" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.16;entryX=0;entryY=0.5;endArrow=block;strokeColor=#ca8a04;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="vps" target="smtp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="networks" value="REDES DOCKER · PERTENENCIA SEGÚN COMPOSE (LAS REDES INTERNAS NO TIENEN SALIDA EXTERNA)" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#334155;fillColor=#e2e8f0;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="2400" height="280" as="geometry"/></mxCell>
        <mxCell id="network-app" value="&lt;b&gt;sipeg-utp-prod&lt;/b&gt; · bridge · api, db, cloudflared, migrate, seed · Tráfico de aplicación, acceso SQL y despliegue." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=14;fontColor=#1e3a8a;fillColor=#eff6ff;" vertex="1" parent="networks"><mxGeometry x="40" y="40" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="network-observability" value="&lt;b&gt;observability&lt;/b&gt; · bridge · grafana, loki, alloy, docker-socket-proxy, prometheus, node-exporter, blackbox-exporter, cloudflared · Consultas, logs y salida de probes públicos." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=14;fontColor=#581c87;fillColor=#faf5ff;" vertex="1" parent="networks"><mxGeometry x="40" y="80" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="network-metrics" value="&lt;b&gt;metrics&lt;/b&gt; · bridge, internal: true · prometheus, api, postgres-exporter, telegraf, blackbox-exporter · Scrapes privados; Node Exporter se alcanza por observability." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=14;fontColor=#134e4a;fillColor=#f0fdfa;" vertex="1" parent="networks"><mxGeometry x="40" y="120" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="network-postgres" value="&lt;b&gt;postgres-metrics&lt;/b&gt; · bridge, internal: true · db, postgres-exporter · SQL de monitorización con el rol de lectura sipeg_monitor." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=14;fontColor=#14532d;fillColor=#f0fdf4;" vertex="1" parent="networks"><mxGeometry x="40" y="160" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="network-docker" value="&lt;b&gt;docker-api&lt;/b&gt; · bridge, internal: true · docker-socket-proxy, alloy, telegraf · Acceso de lectura a logs y estadísticas de Docker, sin mutaciones." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=14;fontColor=#581c87;fillColor=#faf5ff;" vertex="1" parent="networks"><mxGeometry x="40" y="200" width="2320" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Conectores:&lt;/b&gt; azul = solicitudes de negocio; morado = flujo de logs o consulta LogQL (según rótulo); verde azulado = consultas de métricas / probes; gris discontinuo = dependencia de despliegue; dorado = correo saliente agregado de API y Grafana.&lt;br&gt;Cilindros = persistencia; cajas de servicios = contenedores, salvo Docker Engine, destinos HTTP y operaciones del host identificados expresamente. Los volúmenes indican el servicio que los monta." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="2400" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="r2-file-flows" name="3 · Archivos y flujos de Cloudflare R2">
    <mxGraphModel dx="2080" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1560" math="0" shadow="0" background="#ffffff" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SIPEG UTP · Archivos y flujos de Cloudflare R2" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="ARQUITECTURA OBJETIVO · Integración R2 pendiente de implementación | Tres recorridos: subida validada, banners públicos y descarga privada autorizada." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2000" height="50" as="geometry"/></mxCell>
        <mxCell id="clients" value="NAVEGADOR" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#334155;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="200" height="1080" as="geometry"/></mxCell>
        <mxCell id="upload-browser" value="&lt;b&gt;Subir archivo&lt;/b&gt;&lt;br&gt;Formulario de la SPA&lt;br&gt;Multipart vía API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="clients"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="banner-browser" value="&lt;b&gt;Ver banner&lt;/b&gt;&lt;br&gt;Imagen pública&lt;br&gt;URL estable" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#0891b2;fontColor=#164e63;spacing=6;" vertex="1" parent="clients"><mxGeometry x="40" y="400" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="private-browser" value="&lt;b&gt;Pedir documento&lt;/b&gt;&lt;br&gt;Usuario autorizado&lt;br&gt;Identificador de archivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="clients"><mxGeometry x="40" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="download-browser" value="&lt;b&gt;Descargar&lt;/b&gt;&lt;br&gt;Usa la URL firmada&lt;br&gt;Antes de su expiración" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="clients"><mxGeometry x="40" y="1000" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="backend" value="VPS OVH · API Y POSTGRESQL" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1e3a8a;fillColor=#dbeafe;swimlaneFillColor=#f8fbff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="740" height="1080" as="geometry"/></mxCell>
        <mxCell id="upload-api" value="&lt;b&gt;API de archivos&lt;/b&gt;&lt;br&gt;HTTPS público&lt;br&gt;Cloudflare + túnel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="backend"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="validation" value="&lt;b&gt;Valida + autoriza&lt;/b&gt;&lt;br&gt;Tipo real · tamaño&lt;br&gt;Contexto y categoría" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="backend"><mxGeometry x="220" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="storage-client" value="&lt;b&gt;Servicio de archivos&lt;/b&gt;&lt;br&gt;Cliente S3 de R2&lt;br&gt;Bucket + clave nueva" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="backend"><mxGeometry x="400" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="metadata" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Referencias&lt;br&gt;+ metadatos" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;spacingTop=7;" vertex="1" parent="backend"><mxGeometry x="400" y="160" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="upload-note" value="&lt;b&gt;Subida controlada en el backend&lt;/b&gt;&lt;br&gt;Validar contenido, MIME, tamaño y permisos antes de guardar. El servidor decide visibilidad y bucket; genera la clave del objeto.&lt;br&gt;&lt;br&gt;Registrar metadatos después de confirmar la subida. Compensar o reconciliar fallos parciales: PostgreSQL y R2 no comparten una transacción." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;fillColor=#ffffff;strokeColor=#bfdbfe;" vertex="1" parent="backend"><mxGeometry x="40" y="160" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="backend-note" value="&lt;b&gt;Lógica dentro de la API, no contenedores adicionales&lt;/b&gt;&lt;br&gt;Las credenciales S3 permanecen en el servidor. La firma GET se calcula localmente con el identificador del objeto y su expiración; no requiere una petición a R2.&lt;br&gt;PostgreSQL conserva bucket, clave y metadatos, no URLs firmadas. Los banners se entregan directamente desde Cloudflare y no consumen tráfico de descarga de la API." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;fillColor=#ffffff;strokeColor=#bfdbfe;" vertex="1" parent="backend"><mxGeometry x="40" y="520" width="660" height="140" as="geometry"/></mxCell>
        <mxCell id="authorize" value="&lt;b&gt;Autorizar descarga&lt;/b&gt;&lt;br&gt;Resolver archivo&lt;br&gt;Propiedad / permisos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="backend"><mxGeometry x="40" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="signer" value="&lt;b&gt;Firmar GET&lt;/b&gt;&lt;br&gt;Objeto específico&lt;br&gt;TTL configurable" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="backend"><mxGeometry x="220" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="signed-response" value="&lt;b&gt;Respuesta API&lt;/b&gt;&lt;br&gt;URL temporal&lt;br&gt;Sin credenciales S3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="backend"><mxGeometry x="400" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r2-zone" value="CLOUDFLARE · R2 Y ENTREGA DE OBJETOS" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#164e63;fillColor=#cffafe;swimlaneFillColor=#f8feff;strokeColor=#0891b2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="740" height="1080" as="geometry"/></mxCell>
        <mxCell id="s3-api" value="&lt;b&gt;API S3 de R2&lt;/b&gt;&lt;br&gt;HTTPS&lt;br&gt;Autenticación S3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;spacing=6;" vertex="1" parent="r2-zone"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="public-bucket" value="&lt;b&gt;Bucket público&lt;/b&gt;&lt;br&gt;Banners&lt;br&gt;Claves inmutables" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;spacingTop=7;" vertex="1" parent="r2-zone"><mxGeometry x="400" y="160" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="private-bucket" value="&lt;b&gt;Bucket privado&lt;/b&gt;&lt;br&gt;CV · feedback&lt;br&gt;PDF de certificados" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacingTop=7;" vertex="1" parent="r2-zone"><mxGeometry x="580" y="160" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="public-delivery" value="&lt;b&gt;Entrega pública&lt;/b&gt;&lt;br&gt;Dominio personalizado&lt;br&gt;Caché Cloudflare" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;spacing=6;" vertex="1" parent="r2-zone"><mxGeometry x="400" y="400" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r2-note" value="&lt;b&gt;Dos superficies de entrega&lt;/b&gt;&lt;br&gt;Banners: dominio personalizado sobre el bucket público, con caché. El nombre del dominio aún no está definido.&lt;br&gt;Documentos: endpoint S3, sin acceso público del bucket. Las URLs firmadas usan &amp;lt;ACCOUNT_ID&amp;gt;.r2.cloudflarestorage.com, no el dominio personalizado.&lt;br&gt;Los nombres de buckets son descriptivos, no nombres ya aprovisionados." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#164e63;fillColor=#ffffff;strokeColor=#67e8f9;" vertex="1" parent="r2-zone"><mxGeometry x="40" y="520" width="480" height="160" as="geometry"/></mxCell>
        <mxCell id="private-get" value="&lt;b&gt;GET privado en R2&lt;/b&gt;&lt;br&gt;Endpoint S3&lt;br&gt;Verifica firma + TTL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="r2-zone"><mxGeometry x="580" y="760" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="rules" value="CLAVES DEL DISEÑO" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="1840" y="160" width="200" height="1080" as="geometry"/></mxCell>
        <mxCell id="rules-text" value="&lt;b&gt;Subida&lt;/b&gt;&lt;br&gt;Pasa por la API y su validación.&lt;br&gt;&lt;br&gt;&lt;b&gt;Banners&lt;/b&gt;&lt;br&gt;Lectura pública directa; las modificaciones siguen controladas por el backend.&lt;br&gt;&lt;br&gt;&lt;b&gt;Documentos&lt;/b&gt;&lt;br&gt;Autorización antes de emitir el enlace. Quien posea la URL puede usarla hasta su expiración.&lt;br&gt;&lt;br&gt;&lt;b&gt;Red&lt;/b&gt;&lt;br&gt;API → R2 por HTTPS saliente.&lt;br&gt;R2 no usa Cloudflare Tunnel.&lt;br&gt;&lt;br&gt;&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;CORS del bucket solo si el cliente hace fetch directo a R2, con orígenes explícitos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=12;fontColor=#334155;" vertex="1" parent="rules"><mxGeometry x="40" y="40" width="140" height="980" as="geometry"/></mxCell>
        <mxCell id="e-upload-request" value="1 · Multipart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="upload-browser" target="upload-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-upload-validation" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="backend" source="upload-api" target="validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-validation-storage" value="Válido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="backend" source="validation" target="storage-client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-storage-s3" value="2a · PUT HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0891b2;strokeWidth=2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="storage-client" target="s3-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-storage-metadata" value="2b · Registrar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16a34a;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="backend" source="storage-client" target="metadata"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-s3-public" value="Banner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.75;entryX=0.5;entryY=0;endArrow=block;strokeColor=#0891b2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="r2-zone" source="s3-api" target="public-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-s3-private" value="Documento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.25;entryX=0.5;entryY=0;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;jumpStyle=arc;" edge="1" parent="r2-zone" source="s3-api" target="private-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-banner-public" value="A · GET público · no pasa por la API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#0891b2;strokeWidth=2;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="banner-browser" target="public-delivery"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-public-bucket" value="B · Cache miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;strokeColor=#0891b2;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="r2-zone" source="public-delivery" target="public-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-private-request" value="1 · Solicitud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9333ea;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="private-browser" target="authorize"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-authorize-signer" value="2 · Permitido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="backend" source="authorize" target="signer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-signer-response" value="Firma local" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="backend" source="signer" target="signed-response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-response-browser" value="3 · URL temporal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#9333ea;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="signed-response" target="download-browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-browser-private-get" value="4 · GET firmado · descarga directa desde R2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;endArrow=block;strokeColor=#9333ea;strokeWidth=2;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="download-browser" target="private-get"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-private-get-bucket" value="Lee objeto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;strokeColor=#9333ea;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="r2-zone" source="private-get" target="private-bucket"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;RECORRIDOS&lt;/b&gt;&lt;br&gt;Azul / cian superior: subida mediante backend (1 → validación → 2a guardar objeto → 2b registrar metadatos). Cian central: banner público (A → caché; B solo si falta en caché). Morado inferior: descarga privada (1 → 2 → 3 → 4).&lt;br&gt;Las flechas representan solicitudes, pasos de procesamiento o la entrega explícita de la URL; el contenido solicitado regresa por la conexión correspondiente. Las cajas de validación y firma son pasos internos de la misma API.&lt;br&gt;No se ha fijado un hostname de archivos ni nombres reales de buckets. La separación público/privado corresponde a la Fase 6 aprobada del plan maestro." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="2000" height="160" as="geometry"/></mxCell>
        <mxCell id="sources" value="Referencias: plan-maestro-sipeg-utp.md, Fase 6 · Cloudflare R2: S3 API, presigned URLs y public buckets. Los enlaces privados se firman sobre el dominio S3; no sobre el dominio público de banners." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="2000" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
