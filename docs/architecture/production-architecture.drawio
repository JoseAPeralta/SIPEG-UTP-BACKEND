        <mxCell id="e-api-db" value="Prisma · SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
