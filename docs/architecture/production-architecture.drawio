        <mxCell id="e-edge-api" value="REST / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="cloudflare" source="edge" target="api-host"><mxGeometry relative="1" as="geometry"/></mxCell>
