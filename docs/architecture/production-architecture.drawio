        <mxCell id="subtitle" value="Frontend en Cloudflare · backend en VPS OVH · publicación por túnel · archivos en R2 | Diseño objetivo, no inventario certificado del despliegue | 20 oct 2026" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2000" height="50" as="geometry"/></mxCell>
