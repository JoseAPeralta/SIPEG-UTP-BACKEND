        <mxCell id="e-connector-api" value="HTTP · 3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;strokeColor=#2563eb;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="connector" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
