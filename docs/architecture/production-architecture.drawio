        <mxCell id="browser" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;SPA React&lt;br&gt;Usuarios y colaboradores" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;spacing=6;" vertex="1" parent="clients"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
