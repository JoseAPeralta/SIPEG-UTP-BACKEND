        <mxCell id="e-jobs-db" value="Migraciones / seed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="jobs" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-jobs-api" value="Arranque tras éxito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=block;strokeColor=#64748b;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;jumpStyle=arc;" edge="1" parent="vps" source="jobs" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-db-volume" value="Persiste" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16a34a;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="db" target="pg-volume"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-grafana-logs" value="Consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0;entryX=0;entryY=0.5;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="grafana" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-grafana-metrics" value="Consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0d9488;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="vps" source="grafana" target="metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-vps-brevo" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;endArrow=block;strokeColor=#ca8a04;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="vps" target="brevo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;LECTURA DEL DIAGRAMA&lt;/b&gt;&lt;br&gt;Naranja: Cloudflare y túnel · Azul: aplicación / REST / SQL · Cian: archivos R2 · Morado: acceso operativo y logs · Verde azulado: métricas · Dorado: correo.&lt;br&gt;Flecha: quien inicia la solicitud o consulta (las respuestas vuelven por la misma conexión) · Doble flecha: tráfico bidireccional del túnel · Discontinua gris: tareas / dependencias de despliegue.&lt;br&gt;Las cajas internas del VPS resumen servicios Docker; las páginas 2 y 3 amplían contenedores y almacenamiento. El diseño objetivo incluye R2, cuya implementación sigue pendiente." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="2000" height="100" as="geometry"/></mxCell>
        <mxCell id="sources" value="Fuentes: compose.prod.yaml · compose.cloudflare.yaml · compose.observability.yaml · docs/despliegue.md · ADR-0012 / ADR-0014 · Plan maestro, Fase 6. Sin secretos ni identificadores privados." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="2000" height="25" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="containers-observability" name="2 · Contenedores, redes y observabilidad">
    <mxGraphModel dx="2480" dy="1840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1840" math="0" shadow="0" background="#ffffff" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SIPEG UTP · Contenedores, redes y observabilidad" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2400" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Arquitectura objetivo | Grupos funcionales, no fronteras de red: la pertenencia exacta a las cinco redes Docker se detalla abajo. Cada contenedor aparece una sola vez." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2400" height="50" as="geometry"/></mxCell>
        <mxCell id="cf-context" value="CLOUDFLARE" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#9a3412;fillColor=#ffedd5;swimlaneFillColor=#fffaf5;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="200" height="360" as="geometry"/></mxCell>
        <mxCell id="tunnel" value="&lt;b&gt;Cloudflare Tunnel&lt;/b&gt;&lt;br&gt;API + Grafana&lt;br&gt;Ver página 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cf-context"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="cf-note" value="El conector inicia la conexión saliente cifrada. El túnel solo publica los servicios de negocio y Grafana; no tiene rutas para métricas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontFamily=Helvetica;fontSize=12;fontColor=#7c2d12;" vertex="1" parent="cf-context"><mxGeometry x="40" y="160" width="140" height="160" as="geometry"/></mxCell>
        <mxCell id="compose-note" value="&lt;b&gt;COMPOSICIÓN&lt;/b&gt;&lt;br&gt;&lt;br&gt;compose.prod.yaml&lt;br&gt;+ compose.observability.yaml&lt;br&gt;+ compose.cloudflare.yaml&lt;br&gt;&lt;br&gt;&lt;b&gt;Despliegue&lt;/b&gt;&lt;br&gt;db saludable → migrate → seed → API.&lt;br&gt;&lt;br&gt;migrate y seed terminan con éxito; no son servicios permanentes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lectura&lt;/b&gt;&lt;br&gt;Azul: negocio.&lt;br&gt;Morado: logs.&lt;br&gt;Verde azulado: métricas.&lt;br&gt;Gris discontinuo: dependencias de despliegue." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fillColor=#f8fafc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="800" as="geometry"/></mxCell>
        <mxCell id="vps" value="VPS OVH · DOCKER ENGINE + COMPOSE · GRUPOS FUNCIONALES" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1e3a8a;fillColor=#dbeafe;swimlaneFillColor=#f8fbff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="1920" height="1200" as="geometry"/></mxCell>
        <mxCell id="application" value="APLICACIÓN Y TRABAJOS DE DESPLIEGUE" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1e3a8a;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#93c5fd;" vertex="1" parent="vps"><mxGeometry x="40" y="40" width="560" height="480" as="geometry"/></mxCell>
        <mxCell id="migrate" value="&lt;b&gt;migrate&lt;/b&gt;&lt;br&gt;prisma migrate deploy&lt;br&gt;One-shot" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="application"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="seed" value="&lt;b&gt;seed&lt;/b&gt;&lt;br&gt;seed.base.ts&lt;br&gt;One-shot · idempotente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="application"><mxGeometry x="220" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;REST :3000&lt;br&gt;Métricas :9464" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="application"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;PostgreSQL&lt;br&gt;:5432" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;spacingTop=7;" vertex="1" parent="application"><mxGeometry x="400" y="160" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="connector" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;api:3000&lt;br&gt;grafana:3000" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="application"><mxGeometry x="220" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="pg-data" value="&lt;b&gt;postgres_data&lt;/b&gt;&lt;br&gt;Persistencia BD" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;spacingTop=7;" vertex="1" parent="application"><mxGeometry x="400" y="280" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="api-note" value="Node.js 24 · Express · Prisma · Better Auth/JWT. El listener de métricas es independiente del HTTP de negocio; no se publica al host ni en las rutas del túnel." style="text;whiteSpace=wrap;html=1;align=left;spacing=6;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;" vertex="1" parent="application"><mxGeometry x="220" y="400" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="logging" value="LOGS Y CONSULTA OPERATIVA" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#581c87;fillColor=#f3e8ff;swimlaneFillColor=#fefbff;strokeColor=#c084fc;" vertex="1" parent="vps"><mxGeometry x="640" y="40" width="740" height="480" as="geometry"/></mxCell>
        <mxCell id="docker-engine" value="&lt;b&gt;Docker Engine&lt;/b&gt;&lt;br&gt;Host · socket Unix&lt;br&gt;Logs + estadísticas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="logging"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="socket-proxy" value="&lt;b&gt;docker-socket-proxy&lt;/b&gt;&lt;br&gt;:2375 · solo lectura&lt;br&gt;POST=0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="logging"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="alloy" value="&lt;b&gt;alloy&lt;/b&gt;&lt;br&gt;Recolecta / etiqueta&lt;br&gt;Logs de contenedores" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="logging"><mxGeometry x="220" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="loki" value="&lt;b&gt;loki&lt;/b&gt;&lt;br&gt;:3100&lt;br&gt;Almacenamiento de logs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="logging"><mxGeometry x="400" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="grafana" value="&lt;b&gt;grafana&lt;/b&gt;&lt;br&gt;:3000&lt;br&gt;Paneles + alertas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="logging"><mxGeometry x="580" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="logs-note" value="&lt;b&gt;Logs:&lt;/b&gt; API y contenedores → stdout/stderr → Docker → proxy → Alloy → Loki.&lt;br&gt;Alloy solicita logs al proxy sin docker.sock. La API emite JSON con Pino.&lt;br&gt;Grafana consulta por LogQL y conserva su propio login, además de Cloudflare Access." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fontFamily=Helvetica;fontSize=11;fontColor=#581c87;fillColor=#ffffff;strokeColor=#e9d5ff;" vertex="1" parent="logging"><mxGeometry x="40" y="400" width="660" height="60" as="geometry"/></mxCell>
        <mxCell id="persistence" value="VOLÚMENES DE OBSERVABILIDAD" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#581c87;fillColor=#f3e8ff;swimlaneFillColor=#fefbff;strokeColor=#c084fc;" vertex="1" parent="vps"><mxGeometry x="1420" y="40" width="460" height="480" as="geometry"/></mxCell>
        <mxCell id="loki-data" value="&lt;b&gt;loki_data&lt;/b&gt;&lt;br&gt;Loki" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacingTop=7;" vertex="1" parent="persistence"><mxGeometry x="40" y="40" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="alloy-data" value="&lt;b&gt;alloy_data&lt;/b&gt;&lt;br&gt;Estado de Alloy" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacingTop=7;" vertex="1" parent="persistence"><mxGeometry x="220" y="40" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="grafana-data" value="&lt;b&gt;grafana_data&lt;/b&gt;&lt;br&gt;Configuración" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacingTop=7;" vertex="1" parent="persistence"><mxGeometry x="40" y="160" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="prometheus-data" value="&lt;b&gt;prometheus_data&lt;/b&gt;&lt;br&gt;Series temporales" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacingTop=7;" vertex="1" parent="persistence"><mxGeometry x="220" y="160" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="volumes-note" value="&lt;b&gt;Persistencia local del VPS&lt;/b&gt;&lt;br&gt;Los volúmenes sobreviven a la recreación de contenedores. Prometheus retiene hasta 90 días o 2 GB, lo que ocurra primero. Loki, Alloy y Grafana mantienen su estado en sus respectivos volúmenes.&lt;br&gt;Los objetos de aplicación se alojarán en R2 (página 3)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#581c87;fillColor=#ffffff;strokeColor=#e9d5ff;" vertex="1" parent="persistence"><mxGeometry x="40" y="280" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="monitoring" value="MÉTRICAS Y DISPONIBILIDAD · PROMETHEUS PULL" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#134e4a;fillColor=#ccfbf1;swimlaneFillColor=#f8fffd;strokeColor=#5eead4;" vertex="1" parent="vps"><mxGeometry x="40" y="560" width="1340" height="480" as="geometry"/></mxCell>
        <mxCell id="prometheus" value="&lt;b&gt;prometheus&lt;/b&gt;&lt;br&gt;:9090&lt;br&gt;Scrapes + self-scrape" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="node-exporter" value="&lt;b&gt;node-exporter&lt;/b&gt;&lt;br&gt;:9100&lt;br&gt;Host + textfile de red" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="400" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="postgres-exporter" value="&lt;b&gt;postgres-exporter&lt;/b&gt;&lt;br&gt;:9187&lt;br&gt;Rol sipeg_monitor" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="580" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="telegraf" value="&lt;b&gt;telegraf&lt;/b&gt;&lt;br&gt;:9273&lt;br&gt;Métricas de Docker" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="760" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="blackbox" value="&lt;b&gt;blackbox-exporter&lt;/b&gt;&lt;br&gt;:9115&lt;br&gt;Probes HTTP / HTTPS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="940" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="metrics-note" value="&lt;b&gt;Fuentes privadas&lt;/b&gt;&lt;br&gt;Prometheus consulta API :9464, host, PostgreSQL, Docker y disponibilidad. Ningún exporter publica puertos al host. La API instrumenta HTTP y runtime de Node.js.&lt;br&gt;Node Exporter monta el host y el textfile de red en lectura. Telegraf usa el proxy, sin montar docker.sock." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#134e4a;fillColor=#ffffff;strokeColor=#99f6e4;" vertex="1" parent="monitoring"><mxGeometry x="40" y="280" width="480" height="140" as="geometry"/></mxCell>
        <mxCell id="internal-probes" value="&lt;b&gt;Destinos internos&lt;/b&gt;&lt;br&gt;API health + JWKS&lt;br&gt;Grafana health" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="940" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="public-probes" value="&lt;b&gt;Destinos públicos&lt;/b&gt;&lt;br&gt;API health + JWKS&lt;br&gt;Vía Cloudflare + túnel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="monitoring"><mxGeometry x="1120" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="probes-note" value="Los destinos son URLs, no contenedores adicionales. Los probes salen del VPS; no representan un monitor externo independiente." style="text;html=1;whiteSpace=wrap;align=left;spacing=6;fontFamily=Helvetica;fontSize=12;fontColor=#134e4a;" vertex="1" parent="monitoring"><mxGeometry x="940" y="360" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="host-operations" value="OPERACIÓN DEL HOST · FUERA DE CONTENEDORES" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#334155;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="vps"><mxGeometry x="1420" y="560" width="460" height="480" as="geometry"/></mxCell>
        <mxCell id="backup" value="&lt;b&gt;Backup PostgreSQL&lt;/b&gt;&lt;br&gt;pg_dump + cifrado&lt;br&gt;Timer diario · local" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="host-operations"><mxGeometry x="40" y="40" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="host-textfile" value="&lt;b&gt;Métricas de red&lt;/b&gt;&lt;br&gt;Timer → textfile&lt;br&gt;Node Exporter lo lee" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="host-operations"><mxGeometry x="220" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="host-note" value="&lt;b&gt;Diagnóstico local&lt;/b&gt;&lt;br&gt;API: 127.0.0.1:3000&lt;br&gt;Grafana: 127.0.0.1:3001&lt;br&gt;PostgreSQL: sin puerto publicado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Servicios del host&lt;/b&gt;&lt;br&gt;Respaldos cifrados con retención local de 14 días y verificación de restore. El timer de red publica contadores para el textfile collector; Node Exporter no comparte el namespace de red del host." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#334155;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="host-operations"><mxGeometry x="40" y="160" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="vps-note" value="Las agrupaciones organizan responsabilidades. cloudflared participa en aplicación y observabilidad; API y PostgreSQL conservan su red de aplicación y agregan las redes de recolección necesarias. Las redes internas adicionales no publican puertos." style="text;html=1;whiteSpace=wrap;align=left;spacing=8;fontFamily=Helvetica;fontSize=13;fontColor=#1e3a8a;" vertex="1" parent="vps"><mxGeometry x="40" y="1080" width="1840" height="70" as="geometry"/></mxCell>
        <mxCell id="mail-context" value="BREVO · SMTP" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#854d0e;fillColor=#fef3c7;swimlaneFillColor=#fffdf5;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="2240" y="160" width="200" height="1200" as="geometry"/></mxCell>
        <mxCell id="smtp" value="&lt;b&gt;SMTP externo&lt;/b&gt;&lt;br&gt;Brevo :587&lt;br&gt;STARTTLS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;spacing=6;" vertex="1" parent="mail-context"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="smtp-note" value="La API envía correo transaccional.&lt;br&gt;&lt;br&gt;Grafana envía notificaciones de alertas por el mismo proveedor SMTP externo." style="text;html=1;whiteSpace=wrap;align=left;spacing=6;fontFamily=Helvetica;fontSize=12;fontColor=#713f12;" vertex="1" parent="mail-context"><mxGeometry x="40" y="400" width="140" height="180" as="geometry"/></mxCell>
        <mxCell id="e-tunnel-connector" value="Túnel cifrado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;startArrow=block;endArrow=block;strokeColor=#ea580c;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="tunnel" target="connector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-migrate-seed" value="Éxito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="application" source="migrate" target="seed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-db-migrate" value="Saludable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;strokeColor=#64748b;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;jumpStyle=arc;" edge="1" parent="application" source="db" target="migrate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-seed-api" value="Éxito → arranque" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;strokeColor=#64748b;dashed=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="application" source="seed" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-api-db" value="Prisma / SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="application" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-db-data" value="Volumen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#16a34a;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="application" source="db" target="pg-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-connector-api" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;endArrow=block;strokeColor=#2563eb;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="application" source="connector" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
