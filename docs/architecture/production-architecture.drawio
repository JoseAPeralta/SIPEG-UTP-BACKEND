        <mxCell id="cloudflare" value="CLOUDFLARE · SERVICIOS GESTIONADOS" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#9a3412;fillColor=#ffedd5;swimlaneFillColor=#fffaf5;strokeColor=#f97316;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="560" height="960" as="geometry"/></mxCell>
        <mxCell id="edge" value="&lt;b&gt;Cloudflare Edge&lt;/b&gt;&lt;br&gt;DNS · HTTPS&lt;br&gt;Filtrado de tráfico" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="40" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Frontend React&lt;/b&gt;&lt;br&gt;Workers Static Assets&lt;br&gt;sipeg-utp.com" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="220" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="browser-note" value="El frontend se entrega como HTML, CSS y JavaScript. Las llamadas REST salen de la SPA en el navegador hacia el hostname de la API." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#7c2d12;fillColor=#ffffff;strokeColor=#fed7aa;" vertex="1" parent="cloudflare"><mxGeometry x="40" y="160" width="480" height="60" as="geometry"/></mxCell>
        <mxCell id="api-host" value="&lt;b&gt;API pública&lt;/b&gt;&lt;br&gt;api.sipeg-utp.com&lt;br&gt;HTTPS · sin Access" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="220" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="tunnel" value="&lt;b&gt;Cloudflare Tunnel&lt;/b&gt;&lt;br&gt;sipeg-produccion&lt;br&gt;API + Grafana" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;strokeWidth=2;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="400" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;Cloudflare R2&lt;/b&gt;&lt;br&gt;Objetos · S3/HTTPS&lt;br&gt;Públicos + privados" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;spacingTop=7;" vertex="1" parent="cloudflare"><mxGeometry x="220" y="400" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="access" value="&lt;b&gt;Cloudflare Access&lt;/b&gt;&lt;br&gt;Control de acceso&lt;br&gt;Solo para Grafana" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="40" y="520" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="grafana-host" value="&lt;b&gt;Grafana público&lt;/b&gt;&lt;br&gt;grafana.sipeg-utp.com&lt;br&gt;HTTPS · sin caché" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="cloudflare"><mxGeometry x="220" y="520" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="tunnel-note" value="&lt;b&gt;Una conexión saliente, tráfico bidireccional&lt;/b&gt;&lt;br&gt;cloudflared inicia el túnel cifrado desde el VPS. Cloudflare termina HTTPS; el conector alcanza los servicios por HTTP dentro de Docker. No se abren puertos 80/443 entrantes en el VPS." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#7c2d12;fillColor=#ffffff;strokeColor=#fed7aa;" vertex="1" parent="cloudflare"><mxGeometry x="40" y="640" width="480" height="110" as="geometry"/></mxCell>
        <mxCell id="r2-note" value="&lt;b&gt;Almacenamiento objetivo · detalle en página 3&lt;/b&gt;&lt;br&gt;Banners públicos por dominio personalizado y caché. CV, feedback y certificados en bucket privado con descargas autorizadas mediante URL firmada temporal.&lt;br&gt;&lt;br&gt;R2 es un servicio externo al VPS: la API lo utiliza por HTTPS y no pasa por Cloudflare Tunnel. La integración todavía está pendiente en el backend." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#164e63;fillColor=#ecfeff;strokeColor=#67e8f9;" vertex="1" parent="cloudflare"><mxGeometry x="40" y="760" width="480" height="160" as="geometry"/></mxCell>
        <mxCell id="vps" value="VPS OVH · DOCKER ENGINE + COMPOSE" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1e3a8a;fillColor=#dbeafe;swimlaneFillColor=#f8fbff;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="920" height="960" as="geometry"/></mxCell>
        <mxCell id="origin-note" value="&lt;b&gt;Origen de la aplicación&lt;/b&gt;&lt;br&gt;Node.js 24 · Express · TypeScript · Prisma&lt;br&gt;Redes separadas para aplicación, observabilidad y recolección de métricas. Los datos persisten en volúmenes del VPS." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=13;fontColor=#1e3a8a;fillColor=#ffffff;strokeColor=#bfdbfe;" vertex="1" parent="vps"><mxGeometry x="40" y="40" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="jobs" value="&lt;b&gt;migrate → seed&lt;/b&gt;&lt;br&gt;Prisma + catálogo base&lt;br&gt;Tareas de despliegue" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;spacing=6;" vertex="1" parent="vps"><mxGeometry x="580" y="40" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="connector" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;Conector del túnel&lt;br&gt;Dos redes Docker" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;spacing=6;" vertex="1" parent="vps"><mxGeometry x="40" y="280" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;API REST&lt;/b&gt;&lt;br&gt;api:3000&lt;br&gt;JWT · permisos · CORS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=6;" vertex="1" parent="vps"><mxGeometry x="220" y="400" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;db:5432&lt;br&gt;Datos + auditoría" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;spacingTop=7;" vertex="1" parent="vps"><mxGeometry x="580" y="400" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="pg-volume" value="&lt;b&gt;postgres_data&lt;/b&gt;&lt;br&gt;Volumen persistente" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;spacingTop=7;" vertex="1" parent="vps"><mxGeometry x="580" y="520" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;grafana:3000&lt;br&gt;Login · paneles · alertas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="vps"><mxGeometry x="220" y="640" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="logs" value="&lt;b&gt;Logs&lt;/b&gt;&lt;br&gt;Alloy → Loki&lt;br&gt;Proxy Docker de lectura" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacing=6;" vertex="1" parent="vps"><mxGeometry x="400" y="520" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;Prometheus&lt;br&gt;API · host · DB · Docker" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;spacing=6;" vertex="1" parent="vps"><mxGeometry x="580" y="640" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="obs-volume" value="&lt;b&gt;Volúmenes&lt;/b&gt;&lt;br&gt;Loki · Alloy&lt;br&gt;Grafana · Prometheus" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;spacingTop=7;" vertex="1" parent="vps"><mxGeometry x="400" y="760" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="host-note" value="&lt;b&gt;Puertos y persistencia&lt;/b&gt;&lt;br&gt;API: 127.0.0.1:3000 y Grafana: 127.0.0.1:3001, solo diagnóstico local. PostgreSQL y métricas sin puertos publicados. Respaldos locales cifrados de PostgreSQL.&lt;br&gt;Detalle de contenedores y redes en página 2." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fontFamily=Helvetica;fontSize=12;fontColor=#1e3a8a;fillColor=#ffffff;strokeColor=#bfdbfe;" vertex="1" parent="vps"><mxGeometry x="40" y="760" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="external" value="CORREO EXTERNO" style="swimlane;startSize=24;horizontal=1;html=1;whiteSpace=wrap;rounded=1;arcSize=8;collapsible=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#854d0e;fillColor=#fef3c7;swimlaneFillColor=#fffdf5;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="1840" y="160" width="200" height="960" as="geometry"/></mxCell>
        <mxCell id="brevo" value="&lt;b&gt;Brevo&lt;/b&gt;&lt;br&gt;SMTP · 587&lt;br&gt;STARTTLS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;spacing=6;" vertex="1" parent="external"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="mail-note" value="&lt;b&gt;Envíos salientes&lt;/b&gt;&lt;br&gt;&lt;br&gt;API: verificación de correo y recuperación de contraseña.&lt;br&gt;&lt;br&gt;Grafana: notificaciones de alertas." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fontFamily=Helvetica;fontSize=12;fontColor=#713f12;fillColor=#ffffff;strokeColor=#fde68a;" vertex="1" parent="external"><mxGeometry x="40" y="400" width="140" height="230" as="geometry"/></mxCell>
        <mxCell id="e-browser-edge" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;jumpStyle=arc;" edge="1" parent="1" source="browser" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell>
