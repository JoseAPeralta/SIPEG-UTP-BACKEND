        <mxCell id="e-admin-access" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="1" source="admin" target="access"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-access-host" value="Permite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9333ea;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=default;defaultLabelBackgroundColor=gap;" edge="1" parent="cloudflare" source="access" target="grafana-host"><mxGeometry relative="1" as="geometry"/></mxCell>
