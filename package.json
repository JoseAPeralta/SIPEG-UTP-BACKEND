{
  "name": "sipeg-utp-backend",
  "version": "1.0.0",
  "description": "Backend REST API for SIPEG UTP.",
  "homepage": "https://github.com/JoseAPeralta/SIPEG-UTP-BACKEND#readme",
  "bugs": {
    "url": "https://github.com/JoseAPeralta/SIPEG-UTP-BACKEND/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseAPeralta/SIPEG-UTP-BACKEND.git"
  },
  "license": "ISC",
  "author": "Jose A. Peralta",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p prisma/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "tsx src/docs/generate.ts",
    "docs:check": "tsx src/docs/generate.ts --check",
    "api:collection:import": "bru import openapi --source openapi.json --output bruno --collection-name \"SIPEG UTP API\" --collection-format bru --group-by tags",
    "api:run": "pnpm --dir bruno exec bru run -r --env local",
    "api:run:smoke": "pnpm --dir bruno exec bru run Health --env local",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/express-api-reference": "^0.10.19",
    "argon2": "^0.41.1",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/argon2": "^0.15.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.0",
    "@usebruno/cli": "4.1.0",
    "@usebruno/mcp": "github:usebruno/bruno-mcp#0779b7a62e5a0d599dd9c1e170faec720fd85e74",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.11"
  }
}
